# Root build context for Dockerfile (api/worker/migrate/seed).
# Without this file Docker Desktop sent ~350MB+ (web node_modules, .next, .venv).
# The production web image uses this root context to consume docs-user-facing/.

# VCS / IDE
.git
.github
.gds
.claude
.serena
.serena.local-backup-before-ff
.agents
.work
.playwright-mcp
*.md
!README.md

# Local Python / caches
.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.hypothesis
**/.mypy_cache
**/.pyright
**/*.egg-info
.coverage
htmlcov
dist
.site
.site-user-docs

# Node / frontend (not needed in Python images; apps/web has its own Dockerfile)
**/node_modules
**/.next
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo
apps/web
# Dockerfile.prod.dockerignore gives the production web build its narrower
# root-context view without adding the Node tree to Python image contexts.

# Docs toolchain (mkdocs node deps)
docs_scripts/node_modules
docs
!docs_scripts/user-mkdocs.yml
!docs-user-facing/
!docs-user-facing/**

# Research / plans / local env
research_sources
plans
specs
.env
.env.*
!.env.example
!.env.*.example

# Tests not required to build runtime images
tests

# Deploy is host-side; not baked into api/worker images
deploy
!deploy/
!deploy/caddy/
!deploy/caddy/Caddyfile.user-docs
