{
  // Разметка markdown. Смысловые правила проверяет docs_scripts/docs_lint.py,
  // здесь остаются только правила, которые не создают несмысловой churn.
  "config": {
    "default": true,

    // Жёсткая длина строки отключена. Русский нормативный текст, аннотированные
    // ссылки и генерируемые таблицы регулярно превышают произвольный предел,
    // а ручной перенос меняет diff без изменения смысла. Структуру, язык,
    // ссылки, frontmatter и индексы проверяет проектный docs_lint.py.
    "MD013": false,

    // Разрешаем inline HTML: details, маркеры генерируемых блоков.
    "MD033": false,

    // Первая строка файла - frontmatter, а не заголовок.
    "MD041": false,

    // Поле title во frontmatter не считается заголовком документа: иначе
    // единственный H1 в теле выглядит как второй.
    "MD025": { "front_matter_title": "" },

    // Одинаковые заголовки в разных секциях допустимы: "Команды" встречается
    // в нескольких документах на одном уровне вложенности.
    "MD024": { "siblings_only": true },

    // Знаки препинания в заголовках нужны для вопросов вида "Что где лежит?".
    "MD026": { "punctuation": ".,;:!" },

    // Нумерованные списки со сплошной нумерацией.
    "MD029": { "style": "ordered" },

    // Голые URL запрещены: ссылка должна быть аннотирована.
    "MD034": true,

    // Выравнивание столбцов таблиц. Отключено: правило считает ширину в
    // символах, а таблицы на кириллице выравниваются по видимой ширине.
    // Автоисправления у правила нет, ручная подгонка ломается при первой правке.
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    ".site/**",
    // Собранное публичное дерево — вывод, а не источник: полная копия
    // репозитория вместе с чужими зависимостями, установленными при её
    // проверке (`ADR-0108`).
    "public/**",
    ".venv/**",
    ".venv-check/**",
    "research_sources/**",
    // Вредоносные Markdown-фикстуры намеренно нарушают правила обычной документации.
    "tests/fixtures/safety-corpus/**",
    ".work/**",
    ".tmp/**",
    ".serena/**",
    "plans/**",
    "apps/web/test-results/**",
    "apps/web/playwright-report/**",
    "apps/web/blob-report/**"
  ]
}
