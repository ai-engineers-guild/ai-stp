{
  // Markdown structure. Semantic rules live in docs_scripts/docs_lint.py;
  // only rules that avoid meaningless churn remain here.
  "config": {
    "default": true,

    // Hard line length is disabled. Normative text, annotated links, and
    // generated tables regularly exceed arbitrary limits, while manual
    // wrapping changes the diff without changing meaning. Project docs_lint.py
    // checks structure, language, links, frontmatter, and indexes.
    "MD013": false,

    // Allow inline HTML: details and generated-block markers.
    "MD033": false,

    // The first line is frontmatter, not a heading.
    "MD041": false,

    // The frontmatter title is not a document heading; otherwise the only H1
    // in the body looks like a second one.
    "MD025": { "front_matter_title": "" },

    // Identical headings in different sections are allowed: the same heading
    // can occur in multiple documents at one nesting level.
    "MD024": { "siblings_only": true },

    // Heading punctuation is needed for questions such as "Where is it?".
    "MD026": { "punctuation": ".,;:!" },

    // Ordered lists use consecutive numbering.
    "MD029": { "style": "ordered" },

    // Bare URLs are forbidden: links must be annotated.
    "MD034": true,

    // Table-column alignment is disabled: the rule counts characters, while
    // tables with non-Latin text align by visible width. The rule has no
    // automatic fix, and manual tuning breaks on the first edit.
    "MD060": false,

    // MkDocs admonitions and `===` tabs indent four spaces. markdownlint
    // treats that indent as an indented code block, then rejects later
    // fenced ` ``` ` as a mixed style. The two syntaxes have to coexist.
    "MD046": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    ".site/**",
    // The built public tree is output, not source: it is a full copy of the
    // repository together with dependencies installed during its check
    // (`ADR-0108`).
    "public/**",
    ".venv/**",
    ".venv-check/**",
    "research_sources/**",
    // Malicious Markdown fixtures intentionally violate ordinary-document rules.
    "tests/fixtures/safety-corpus/**",
    ".work/**",
    ".tmp/**",
    ".serena/**",
    "plans/**",
    "apps/web/test-results/**",
    "apps/web/playwright-report/**",
    "apps/web/blob-report/**"
  ]
}
