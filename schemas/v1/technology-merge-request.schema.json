{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:technology-merge-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^corporate:organization_[A-Za-z0-9_-]+:[1-9][0-9]*:[1-9][0-9]*$",
          "type": "string"
        }
      ],
      "title": "Authorization Revision"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_expected_revision": {
      "minimum": 1,
      "title": "Target Expected Revision",
      "type": "integer"
    },
    "target_id": {
      "pattern": "^technology_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "authorization_revision",
    "expected_revision",
    "idempotency_key",
    "target_id",
    "target_expected_revision",
    "plan_digest"
  ],
  "title": "TechnologyMergeRequest",
  "type": "object"
}
