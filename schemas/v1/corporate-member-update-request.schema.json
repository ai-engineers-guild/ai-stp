{
  "$id": "urn:ai-stp:schema:v1:corporate-member-update-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "role": {
      "enum": [
        "superadmin",
        "lead",
        "staff"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "active",
        "suspended"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "role",
    "state",
    "expected_revision",
    "authorization_revision"
  ],
  "title": "CorporateMemberUpdateRequest",
  "type": "object"
}
