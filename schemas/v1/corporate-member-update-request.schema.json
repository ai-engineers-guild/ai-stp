{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-member-update-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "job_title_id": {
      "anyOf": [
        {
          "pattern": "^job_title_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Title Id"
    },
    "role": {
      "description": "Tenant-local role name.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "active",
        "suspended"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "role",
    "state",
    "expected_revision",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateMemberUpdateRequest",
  "type": "object"
}
