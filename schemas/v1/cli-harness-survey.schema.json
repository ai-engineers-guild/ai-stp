{
  "$defs": {
    "HarnessInstallation": {
      "additionalProperties": true,
      "description": "One place a harness was found (`SPEC-014` REQ-1417).",
      "properties": {
        "diagnostic": {
          "default": "version_reported",
          "minLength": 1,
          "title": "Diagnostic",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "surface": {
          "default": "cli",
          "enum": [
            "cli",
            "desktop"
          ],
          "title": "Surface",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_source": {
          "default": "process",
          "enum": [
            "process",
            "package_metadata",
            "windows_package_metadata",
            "unavailable"
          ],
          "title": "Version Source",
          "type": "string"
        }
      },
      "required": [
        "diagnostic",
        "path",
        "reason",
        "schema_version",
        "surface",
        "version",
        "version_source"
      ],
      "title": "HarnessInstallation",
      "type": "object"
    },
    "HarnessPresence": {
      "additionalProperties": true,
      "description": "What is known about one harness on this machine (`REQ-1415`).",
      "properties": {
        "configuration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration"
        },
        "harness_id": {
          "minLength": 1,
          "title": "Harness Id",
          "type": "string"
        },
        "installations": {
          "items": {
            "$ref": "#/$defs/HarnessInstallation"
          },
          "title": "Installations",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "enum": [
            "configured",
            "installed",
            "unknown_version",
            "available"
          ],
          "title": "State",
          "type": "string"
        },
        "support": {
          "enum": [
            "primary",
            "beta"
          ],
          "title": "Support",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "configuration",
        "harness_id",
        "installations",
        "reason",
        "schema_version",
        "state",
        "support",
        "title"
      ],
      "title": "HarnessPresence",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-harness-survey",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Every declared harness, whether or not it is here.\n\nTotal by construction. A harness absent from the answer would be\nindistinguishable from one this build does not support, and `REQ-1414`\nmakes the supported set the point.",
  "properties": {
    "harnesses": {
      "items": {
        "$ref": "#/$defs/HarnessPresence"
      },
      "title": "Harnesses",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "harnesses",
    "schema_version"
  ],
  "title": "HarnessSurvey",
  "type": "object"
}
