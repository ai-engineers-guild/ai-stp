{
  "$defs": {
    "CorporateTeammate": {
      "additionalProperties": true,
      "description": "Reduced people projection — no email, job title, or organization role.",
      "properties": {
        "account_id": {
          "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Account Id",
          "type": "string"
        },
        "contexts": {
          "items": {
            "$ref": "#/$defs/CorporateTeammateContext"
          },
          "maxItems": 256,
          "title": "Contexts",
          "type": "array"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Name"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "account_id",
        "contexts",
        "display_name",
        "schema_version"
      ],
      "title": "CorporateTeammate",
      "type": "object"
    },
    "CorporateTeammateContext": {
      "additionalProperties": true,
      "description": "One participation context a teammate shares with the caller.",
      "properties": {
        "id": {
          "maxLength": 64,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "team",
            "project"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "maxLength": 16,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "role"
      ],
      "title": "CorporateTeammateContext",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-teammates",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/CorporateTeammate"
      },
      "maxItems": 512,
      "title": "Items",
      "type": "array"
    },
    "organization_id": {
      "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Organization Id",
      "type": "string"
    },
    "people_visibility": {
      "enum": [
        "members",
        "teammates",
        "admins"
      ],
      "title": "People Visibility",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "organization_id",
    "people_visibility",
    "schema_version"
  ],
  "title": "CorporateTeammates",
  "type": "object"
}
