{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-binding-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Account Id",
      "type": "string"
    },
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "role": {
      "enum": [
        "superadmin",
        "lead",
        "staff"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "default": "*",
      "maxLength": 64,
      "minLength": 1,
      "title": "Scope Id",
      "type": "string"
    },
    "scope_kind": {
      "enum": [
        "system",
        "organization",
        "team",
        "project",
        "technology",
        "catalog_object",
        "telemetry"
      ],
      "title": "Scope Kind",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "role",
    "scope_kind",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateBindingRequest",
  "type": "object"
}
