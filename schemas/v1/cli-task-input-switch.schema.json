{
  "$defs": {
    "HarnessId": {
      "enum": [
        "claude-code",
        "codex",
        "pi",
        "opencode",
        "grok-build",
        "cursor",
        "antigravity"
      ],
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-task-input-switch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Restore last user working config. Omitted snapshot means the latest preserved setup.",
  "properties": {
    "harness_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preserved_setup_id": {
      "anyOf": [
        {
          "pattern": "^setup_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preserved Setup Id"
    },
    "project_root": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Root"
    },
    "reload_session": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reload Session"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "TaskSwitchInput",
  "type": "object"
}
