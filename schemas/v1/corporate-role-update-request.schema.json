{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-role-update-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "parent_role": {
      "anyOf": [
        {
          "description": "Tenant-local role name.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Role"
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Permissions",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "permissions",
    "expected_revision",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateRoleUpdateRequest",
  "type": "object"
}
