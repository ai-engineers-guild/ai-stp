{
  "$defs": {
    "OAuthProvider": {
      "enum": [
        "google",
        "github",
        "authentik",
        "keycloak",
        "gitlab",
        "saml"
      ],
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-task-input-publish",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Publish a local object through the existing no-binding publication plan.",
  "properties": {
    "directory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Directory"
    },
    "object_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Id"
    },
    "object_version": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Version"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/OAuthProvider"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "visibility": {
      "anyOf": [
        {
          "enum": [
            "public",
            "private"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visibility"
    }
  },
  "title": "TaskPublishInput",
  "type": "object"
}
