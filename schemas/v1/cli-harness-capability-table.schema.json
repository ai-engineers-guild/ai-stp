{
  "$defs": {
    "CapabilityState": {
      "enum": [
        "supported",
        "projection_missing",
        "project_only",
        "routed_only",
        "unsupported"
      ],
      "type": "string"
    },
    "ComponentType": {
      "enum": [
        "instruction",
        "skill",
        "mcp",
        "hook",
        "command",
        "agent",
        "plugin",
        "setting",
        "cli"
      ],
      "type": "string"
    },
    "HarnessCapabilityRow": {
      "additionalProperties": false,
      "description": "One executable row from the closed harness capability catalog.",
      "properties": {
        "component_types": {
          "items": {
            "$ref": "#/$defs/ComponentType"
          },
          "title": "Component Types",
          "type": "array"
        },
        "components": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/HarnessComponentCapability"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Components"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "global_layouts": {
          "items": {
            "type": "string"
          },
          "title": "Global Layouts",
          "type": "array"
        },
        "harness_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessId"
            },
            {
              "const": "undefined",
              "type": "string"
            }
          ],
          "title": "Harness Id"
        },
        "layout_sources": {
          "items": {
            "type": "string"
          },
          "title": "Layout Sources",
          "type": "array"
        },
        "native_authoring": {
          "items": {
            "type": "string"
          },
          "title": "Native Authoring",
          "type": "array"
        },
        "project_layouts": {
          "items": {
            "type": "string"
          },
          "title": "Project Layouts",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "support": {
          "enum": [
            "primary",
            "beta",
            "portable"
          ],
          "title": "Support",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "harness_id",
        "title",
        "support",
        "component_types",
        "native_authoring",
        "global_layouts",
        "project_layouts",
        "layout_sources",
        "gaps"
      ],
      "title": "HarnessCapabilityRow",
      "type": "object"
    },
    "HarnessComponentCapability": {
      "additionalProperties": false,
      "description": "One `(harness, kind)` cell, with native support and projection kept apart.\n\nReading a single list of kinds as \"what can be installed\" is the mistake\nthis exists to remove: the catalogue answers what the *product* reads, and\nthe compiler answers what this build can hand a provider. They are different\nquestions and they disagree on ten of the native-layout cells.\n\n**None of these fields claims a component is active.** Whether an installed\nthing is loaded, parsed and running is a third question, and for at least\none surface it is not answerable from outside the product at all: driven at\na temporary `CODEX_HOME` in four states — valid, malformed, an invented\nevent name, an invented top-level key — codex produced byte-identical\noutput, and identical again with the file absent. A model that reported\n\"active\" would have to invent that answer for codex hooks. Runtime evidence\nis a separate record tied to versions, OS and scope (`#462`, item 8).",
      "properties": {
        "component_type": {
          "$ref": "#/$defs/ComponentType"
        },
        "native_at_owned_scope": {
          "title": "Native At Owned Scope",
          "type": "boolean"
        },
        "native_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Native Scopes",
          "type": "array"
        },
        "native_support": {
          "title": "Native Support",
          "type": "boolean"
        },
        "projection_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Projection Scopes",
          "type": "array"
        },
        "projection_support": {
          "title": "Projection Support",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/CapabilityState"
        }
      },
      "required": [
        "component_type",
        "native_support",
        "native_at_owned_scope",
        "projection_support",
        "native_scopes",
        "projection_scopes",
        "state"
      ],
      "title": "HarnessComponentCapability",
      "type": "object"
    },
    "HarnessId": {
      "enum": [
        "claude-code",
        "codex",
        "pi",
        "opencode",
        "grok-build",
        "cursor",
        "antigravity"
      ],
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-harness-capability-table",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The complete supported harness table, including shared conventions.",
  "properties": {
    "harnesses": {
      "items": {
        "$ref": "#/$defs/HarnessCapabilityRow"
      },
      "title": "Harnesses",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "harnesses"
  ],
  "title": "HarnessCapabilityTable",
  "type": "object"
}
