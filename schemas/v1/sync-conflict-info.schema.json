{
  "$defs": {
    "RevisionId": {
      "pattern": "^revision_[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:sync-conflict-info",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Enough graph material for the client to locate a common ancestor.",
  "properties": {
    "affected_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Affected Fields",
      "type": "array"
    },
    "client_head_revision_id": {
      "$ref": "#/$defs/RevisionId"
    },
    "common_ancestor_revision_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "server_head_revision_id": {
      "$ref": "#/$defs/RevisionId"
    }
  },
  "required": [
    "affected_fields",
    "client_head_revision_id",
    "common_ancestor_revision_id",
    "schema_version",
    "server_head_revision_id"
  ],
  "title": "SyncConflictInfo",
  "type": "object"
}
