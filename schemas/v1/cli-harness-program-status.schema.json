{
  "$defs": {
    "HarnessProgramOperation": {
      "additionalProperties": true,
      "description": "One program operation this installation recorded against a prefix.",
      "properties": {
        "at": {
          "minLength": 1,
          "title": "At",
          "type": "string"
        },
        "operation": {
          "enum": [
            "software_install",
            "software_update",
            "software_remove"
          ],
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "minLength": 1,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "at",
        "operation",
        "operation_id",
        "schema_version",
        "state"
      ],
      "title": "HarnessProgramOperation",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-harness-program-status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "A historical program-prefix observation from its journal and filesystem.\n\nThe journal records the original operation; filesystem absence is reported as\nlost. version comes from the journal without executing the observed program.",
  "properties": {
    "entry_point": {
      "default": "",
      "title": "Entry Point",
      "type": "string"
    },
    "executable": {
      "default": "",
      "title": "Executable",
      "type": "string"
    },
    "harness_id": {
      "minLength": 1,
      "title": "Harness Id",
      "type": "string"
    },
    "operation_id": {
      "default": "",
      "title": "Operation Id",
      "type": "string"
    },
    "prefix": {
      "minLength": 1,
      "title": "Prefix",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "recorded_at": {
      "default": "",
      "title": "Recorded At",
      "type": "string"
    },
    "recorded_operation": {
      "default": "",
      "title": "Recorded Operation",
      "type": "string"
    },
    "recorded_state": {
      "default": "",
      "title": "Recorded State",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "present",
        "removed",
        "never_installed",
        "foreign",
        "lost",
        "interrupted"
      ],
      "title": "State",
      "type": "string"
    },
    "stopped": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HarnessProgramOperation"
      },
      "title": "Stopped",
      "type": "array"
    },
    "version": {
      "default": "",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "entry_point",
    "executable",
    "harness_id",
    "operation_id",
    "prefix",
    "reason",
    "recorded_at",
    "recorded_operation",
    "recorded_state",
    "schema_version",
    "state",
    "stopped",
    "version"
  ],
  "title": "HarnessProgramStatus",
  "type": "object"
}
