{
  "$defs": {
    "ContentBody": {
      "maxLength": 200000,
      "minLength": 1,
      "type": "string"
    },
    "ContentCommit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "ContentDate": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "ContentDescription": {
      "maxLength": 320,
      "minLength": 1,
      "type": "string"
    },
    "ContentImage": {
      "maxLength": 512,
      "pattern": "^/content/illustrations/[a-z0-9._-]+\\.(?:svg|png|jpg|jpeg|webp|gif)$",
      "type": "string"
    },
    "ContentImageAlt": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "ContentLocale": {
      "enum": [
        "ru",
        "en"
      ],
      "type": "string"
    },
    "ContentSlug": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "ContentSnapshotEntry": {
      "additionalProperties": false,
      "description": "One published localized repository article in a snapshot.",
      "properties": {
        "body": {
          "$ref": "#/$defs/ContentBody"
        },
        "content_digest": {
          "$ref": "#/$defs/DigestValue"
        },
        "cover_alt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentImageAlt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cover_image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "$ref": "#/$defs/ContentDescription"
        },
        "locale": {
          "$ref": "#/$defs/ContentLocale"
        },
        "published_at": {
          "$ref": "#/$defs/ContentDate"
        },
        "slug": {
          "$ref": "#/$defs/ContentSlug"
        },
        "source_kind": {
          "const": "repository",
          "default": "repository",
          "title": "Source Kind",
          "type": "string"
        },
        "source_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/ContentCommit"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/ContentTag"
          },
          "maxItems": 12,
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/ContentTitle"
        },
        "type": {
          "$ref": "#/$defs/ContentType"
        }
      },
      "required": [
        "type",
        "slug",
        "locale",
        "title",
        "description",
        "published_at",
        "tags",
        "body",
        "content_digest",
        "source_ref",
        "source_path"
      ],
      "title": "ContentSnapshotEntry",
      "type": "object"
    },
    "ContentTag": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
    },
    "ContentTitle": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "ContentType": {
      "enum": [
        "article",
        "blog_post",
        "changelog",
        "release_notes"
      ],
      "type": "string"
    },
    "DigestValue": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:content-repository-import-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Full replacement of the repository-owned active article set.",
  "properties": {
    "commit": {
      "$ref": "#/$defs/ContentCommit"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ContentSnapshotEntry"
      },
      "maxItems": 10000,
      "title": "Entries",
      "type": "array"
    },
    "expected_generation": {
      "minimum": 0,
      "title": "Expected Generation",
      "type": "integer"
    },
    "repository": {
      "const": "ai-engineers-guild/ai-stp",
      "default": "ai-engineers-guild/ai-stp",
      "title": "Repository",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_digest": {
      "$ref": "#/$defs/DigestValue"
    }
  },
  "required": [
    "commit",
    "snapshot_digest",
    "expected_generation",
    "entries"
  ],
  "title": "ContentRepositoryImportRequest",
  "type": "object"
}
