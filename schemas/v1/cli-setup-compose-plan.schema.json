{
  "$defs": {
    "SetupComposeMember": {
      "additionalProperties": false,
      "description": "One exact member frozen by a setup composition plan.",
      "properties": {
        "embedded": {
          "title": "Embedded",
          "type": "boolean"
        },
        "source": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "stable_id": {
          "minLength": 1,
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "stable_id",
        "version",
        "source",
        "embedded"
      ],
      "title": "SetupComposeMember",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-setup-compose-plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact preview for a new mixed catalog/Git/package/path setup.",
  "properties": {
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "definition_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Definition Digest",
      "type": "string"
    },
    "harness_id": {
      "minLength": 1,
      "title": "Harness Id",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/SetupComposeMember"
      },
      "title": "Members",
      "type": "array"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "setup_id": {
      "minLength": 1,
      "title": "Setup Id",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "setup_id",
    "version",
    "harness_id",
    "created_at",
    "definition_digest",
    "plan_digest",
    "members"
  ],
  "title": "SetupComposePlan",
  "type": "object"
}
