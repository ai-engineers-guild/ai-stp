{
  "$id": "urn:ai-stp:schema:v1:cli-imported-setup",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "A registered import and the backup it was taken alongside.\n\nTwo identifiers because they are two objects (`REQ-814`). A backup says\nwhere the old bytes are; a setup says what was made from them. Deleting the\nfirst must not delete the identity of the second.",
  "properties": {
    "backup_id": {
      "minLength": 1,
      "title": "Backup Id",
      "type": "string"
    },
    "component_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Component Ids",
      "type": "array"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "redacted_keys": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Redacted Keys",
      "type": "array"
    },
    "revision_id": {
      "minLength": 1,
      "title": "Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stable_id": {
      "minLength": 1,
      "title": "Stable Id",
      "type": "string"
    }
  },
  "required": [
    "backup_id",
    "component_ids",
    "plan_digest",
    "redacted_keys",
    "revision_id",
    "schema_version",
    "stable_id"
  ],
  "title": "ImportedSetup",
  "type": "object"
}
