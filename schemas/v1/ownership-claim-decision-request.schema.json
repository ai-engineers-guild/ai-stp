{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:ownership-claim-decision-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "POST /v1/staff/ownership-claims/{claim_id}/approve or /deny body.",
  "properties": {
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "reason",
    "idempotency_key"
  ],
  "title": "OwnershipClaimDecisionRequest",
  "type": "object"
}
