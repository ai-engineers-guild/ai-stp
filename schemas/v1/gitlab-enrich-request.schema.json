{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:gitlab-enrich-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_revision": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Authorization Revision",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "mapping_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._+-]+$",
      "title": "Mapping Version",
      "type": "string"
    },
    "scan_id": {
      "pattern": "^scan_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "authorization_revision",
    "expected_revision",
    "idempotency_key",
    "scan_id",
    "mapping_version"
  ],
  "title": "GitLabEnrichRequest",
  "type": "object"
}
