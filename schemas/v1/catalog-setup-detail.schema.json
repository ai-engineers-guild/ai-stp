          "$ref": "#/$defs/CatalogSupport"
        },
        "latest_tags": {
          "$ref": "#/$defs/Tags"
        },
        "latest_target_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Target Role"
        },
        "latest_trust": {
          "$ref": "#/$defs/CatalogTrust"
        },
        "latest_version": {
          "$ref": "#/$defs/Version"
        },
