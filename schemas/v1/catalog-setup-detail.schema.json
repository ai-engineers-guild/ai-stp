{
  "$defs": {
    "AlignmentState": {
      "enum": [
        "aligned",
        "diverged",
        "unknown",
        "missing"
      ],
      "type": "string"
    },
    "AssessmentState": {
      "enum": [
        "not_verified",
        "verified",
        "failed",
        "stale"
      ],
      "type": "string"
    },
    "CatalogSupport": {
      "additionalProperties": true,
      "description": "Provider support status, separate from object trust and verification.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/CatalogSupportEvidence"
          },
          "maxItems": 32,
          "title": "Evidence",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/SupportState"
        },
        "tier": {
          "$ref": "#/$defs/SupportTier"
        }
      },
      "required": [
        "evidence",
        "schema_version",
        "state",
        "tier"
      ],
      "title": "CatalogSupport",
      "type": "object"
    },
    "CatalogSupportEvidence": {
      "additionalProperties": true,
      "description": "Safe public summary of one provider support check (SPEC-033, ADR-0072).",
      "properties": {
        "architecture": {
          "$ref": "#/$defs/SupportArchitecture"
        },
        "check_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "operating_system": {
          "$ref": "#/$defs/SupportOperatingSystem"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "release_reference": {
          "pattern": "^(?:[0-9a-f]{40,64}|sha256:[0-9a-f]{64})$",
          "title": "Release Reference",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/SupportEvidenceResult"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/SupportEvidenceSource"
        }
      },
      "required": [
        "architecture",
        "check_id",
        "expires_at",
        "mandatory",
        "observed_at",
        "operating_system",
        "policy_version",
        "provider_id",
        "provider_version",
        "release_reference",
        "result",
        "schema_version",
        "source"
      ],
      "title": "CatalogSupportEvidence",
      "type": "object"
    },
    "CatalogTrust": {
      "additionalProperties": true,
      "description": "Why a published version may appear in results, and on whose evidence.\n\nThe two verification flags are independent axes (ADR-0016) and neither may\nbe computed from the other. `authoritative` additionally requires both, and\nthat implication is enforced below — enforcing it is not the same as\nderiving one axis from the other, and a client must still read the flags.",
      "properties": {
        "author_verified": {
          "title": "Author Verified",
          "type": "boolean"
        },
        "component_verified": {
          "title": "Component Verified",
          "type": "boolean"
        },
        "trust_lane": {
          "$ref": "#/$defs/CatalogTrustLane"
        }
      },
      "required": [
        "author_verified",
        "component_verified",
        "trust_lane"
      ],
      "title": "CatalogTrust",
      "type": "object"
    },
    "CatalogTrustLane": {
      "enum": [
        "authoritative",
        "experimental"
      ],
      "type": "string"
    },
    "CatalogUsageMetrics": {
      "additionalProperties": true,
      "description": "Server aggregate of public detail views and completed artifact bytes.\n\nAbsence of this object means the feature is off or the value is unavailable,\nnot zero. Download is not install success.",
      "properties": {
        "artifact_downloads_count": {
          "minimum": 0,
          "title": "Artifact Downloads Count",
          "type": "integer"
        },
        "detail_views_count": {
          "minimum": 0,
          "title": "Detail Views Count",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_downloads_count",
        "detail_views_count",
        "schema_version"
      ],
      "title": "CatalogUsageMetrics",
      "type": "object"
    },
    "CheckResult": {
      "enum": [
        "passed",
        "warning",
        "failed",
        "degraded",
        "not_run",
        "not_applicable",
        "skipped",
        "running"
      ],
      "type": "string"
    },
    "ChecksStatus": {
      "enum": [
        "pending",
        "available",
        "empty",
        "incomplete"
      ],
      "type": "string"
    },
    "ComponentId": {
      "pattern": "^component_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "CountryCode": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
    },
    "DescriptionExcerpt": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ExternalProductSummary": {
      "additionalProperties": true,
      "description": "Curated external service, keyed by its registrable domain.",
      "properties": {
        "canonical_domain": {
          "maxLength": 253,
          "minLength": 3,
          "title": "Canonical Domain",
          "type": "string"
        },
        "country_codes": {
          "items": {
            "$ref": "#/$defs/CountryCode"
          },
          "maxItems": 249,
          "title": "Country Codes",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 320,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "primary_url": {
          "maxLength": 512,
          "pattern": "^https://",
          "title": "Primary Url",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^https://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "canonical_domain",
        "country_codes",
        "description",
        "name",
        "primary_url",
        "schema_version",
        "source_url"
      ],
      "title": "ExternalProductSummary",
      "type": "object"
    },
    "FamilyCreatedFrom": {
      "enum": [
        "recast",
        "owner",
        "staff_migration",
        "migration"
      ],
      "type": "string"
    },
    "FamilyId": {
      "pattern": "^family_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "FamilyMatchKind": {
      "enum": [
        "family",
        "member_harness",
        "alignment"
      ],
      "type": "string"
    },
    "FindingSeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "HarnessId": {
      "enum": [
        "claude-code",
        "codex",
        "pi",
        "opencode",
        "grok-build",
        "cursor",
        "antigravity"
      ],
      "type": "string"
    },
    "ImplementationMode": {
      "enum": [
        "derived",
        "native"
      ],
      "type": "string"
    },
    "PassportDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ProjectionKind": {
      "enum": [
        "marketplace",
        "plugin",
        "native_files",
        "package"
      ],
      "type": "string"
    },
    "PublicLifecycle": {
      "enum": [
        "active",
        "deprecated",
        "blocked"
      ],
      "type": "string"
    },
    "RecommendationState": {
      "enum": [
        "recommended",
        "not_recommended",
        "ineffective"
      ],
      "type": "string"
    },
    "SafetyCheckEntry": {
      "additionalProperties": true,
      "description": "One check line on an audit list.",
      "properties": {
        "check_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "family": {
          "default": "",
          "maxLength": 64,
          "title": "Family",
          "type": "string"
        },
        "finding_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafetyFindingSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result": {
          "$ref": "#/$defs/CheckResult"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "default": "platform_safety_scan",
          "maxLength": 64,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "family",
        "finding_summary",
        "mandatory",
        "reason",
        "result",
        "schema_version",
        "source"
      ],
      "title": "SafetyCheckEntry",
      "type": "object"
    },
    "SafetyChecksSummary": {
      "additionalProperties": true,
      "description": "Card/detail projection for checks percent and status.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/SafetyCheckEntry"
          },
          "maxItems": 128,
          "title": "Checks",
          "type": "array"
        },
        "checks_passed_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checks Passed Percent"
        },
        "coverage_complete": {
          "default": true,
          "title": "Coverage Complete",
          "type": "boolean"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "not_run": {
          "default": 0,
          "minimum": 0,
          "title": "Not Run",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ChecksStatus"
        },
        "total_countable": {
          "default": 0,
          "minimum": 0,
          "title": "Total Countable",
          "type": "integer"
        },
        "warning": {
          "default": 0,
          "minimum": 0,
          "title": "Warning",
          "type": "integer"
        }
      },
      "required": [
        "checks",
        "checks_passed_percent",
        "coverage_complete",
        "failed",
        "not_run",
        "passed",
        "schema_version",
        "status",
        "total_countable",
        "warning"
      ],
      "title": "SafetyChecksSummary",
      "type": "object"
    },
    "SafetyFindingSummary": {
      "additionalProperties": true,
      "description": "Bounded public identifiers for findings; never scanned content.",
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "paths": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Paths",
          "type": "array"
        },
        "rule_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Rule Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "severity_max": {
          "$ref": "#/$defs/FindingSeverity"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "count",
        "paths",
        "rule_ids",
        "schema_version",
        "severity_max",
        "truncated"
      ],
      "title": "SafetyFindingSummary",
      "type": "object"
    },
    "SelectedAdaptation": {
      "additionalProperties": true,
      "description": "The one adaptation selected for the viewed setup harness.",
      "properties": {
        "adaptation_id": {
          "pattern": "^adaptation_[0-9a-f]{64}$",
          "title": "Adaptation Id",
          "type": "string"
        },
        "assessment_state": {
          "$ref": "#/$defs/AssessmentState",
          "default": "not_verified"
        },
        "harness_id": {
          "$ref": "#/$defs/HarnessId"
        },
        "implementation_mode": {
          "$ref": "#/$defs/ImplementationMode"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "projection_kind": {
          "$ref": "#/$defs/ProjectionKind"
        },
        "recommendation": {
          "$ref": "#/$defs/RecommendationState",
          "default": "ineffective"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "technical_support": {
          "$ref": "#/$defs/TechnicalSupport"
        }
      },
      "required": [
        "adaptation_id",
        "assessment_state",
        "harness_id",
        "implementation_mode",
        "limitations",
        "projection_kind",
        "recommendation",
        "schema_version",
        "scopes",
        "technical_support"
      ],
      "title": "SelectedAdaptation",
      "type": "object"
    },
    "SetupComponentChecks": {
      "additionalProperties": true,
      "description": "Checks for one exact component snapshot inside a setup.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/SafetyCheckEntry"
          },
          "title": "Checks",
          "type": "array"
        },
        "digest_matches": {
          "title": "Digest Matches",
          "type": "boolean"
        },
        "embedded": {
          "title": "Embedded",
          "type": "boolean"
        },
        "failed_mandatory": {
          "title": "Failed Mandatory",
          "type": "boolean"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_coordinate": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Coordinate"
        },
        "stable_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "checks",
        "digest_matches",
        "embedded",
        "failed_mandatory",
        "name",
        "source_coordinate",
        "stable_id",
        "version"
      ],
      "title": "SetupComponentChecks",
      "type": "object"
    },
    "SetupCompositionMember": {
      "additionalProperties": true,
      "description": "Exact component pin plus the selected adaptation for this setup harness.",
      "properties": {
        "passport_digest": {
          "$ref": "#/$defs/Digest"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "selected_adaptation": {
          "$ref": "#/$defs/SelectedAdaptation"
        },
        "stable_id": {
          "$ref": "#/$defs/ComponentId"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "passport_digest",
        "schema_version",
        "selected_adaptation",
        "stable_id",
        "version"
      ],
      "title": "SetupCompositionMember",
      "type": "object"
    },
    "SetupFamilyMember": {
      "additionalProperties": true,
      "description": "One accessible family member. Public reads omit inaccessible identity.",
      "properties": {
        "alignment": {
          "$ref": "#/$defs/AlignmentState"
        },
        "exact_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Version"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "harness_id": {
          "$ref": "#/$defs/HarnessId"
        },
        "latest_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Version"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passport_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ported_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stable_id": {
          "$ref": "#/$defs/SetupId"
        }
      },
      "required": [
        "alignment",
        "exact_version",
        "harness_id",
        "latest_version",
        "name",
        "passport_digest",
        "ported_from",
        "schema_version",
        "stable_id"
      ],
      "title": "SetupFamilyMember",
      "type": "object"
    },
    "SetupFamilyPublic": {
      "additionalProperties": true,
      "description": "Public navigational family projection. Never installable content.",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/SetupRef"
        },
        "created_from": {
          "$ref": "#/$defs/FamilyCreatedFrom"
        },
        "current_member": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupFamilyMember"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "family_id": {
          "$ref": "#/$defs/FamilyId"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/SetupFamilyMember"
          },
          "maxItems": 7,
          "title": "Members",
          "type": "array"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "baseline",
        "created_from",
        "current_member",
        "family_id",
        "members",
        "name",
        "schema_version"
      ],
      "title": "SetupFamilyPublic",
      "type": "object"
    },
    "SetupId": {
      "pattern": "^setup_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "SetupRef": {
      "additionalProperties": false,
      "description": "Exact reference to a setup version; a setup has no variant axis.",
      "properties": {
        "passport_digest": {
          "$ref": "#/$defs/PassportDigest"
        },
        "stable_id": {
          "pattern": "^setup_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "stable_id",
        "version",
        "passport_digest"
      ],
      "title": "SetupRef",
      "type": "object"
    },
    "SetupSummary": {
      "additionalProperties": true,
      "description": "Search-result card for a setup. A setup has no variant axis (ADR-0014).\n\n`latest_harness_id` keeps the prefix even though a setup belongs to one\nharness from creation: the value is still read out of the version passport,\nand one rule with no exceptions is cheaper to verify than a rule with one.",
      "properties": {
        "family_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/FamilyId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "family_match_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/FamilyMatchKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "family_member_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Member Count"
        },
        "github_stars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Stars"
        },
        "latest_checks": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafetyChecksSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "latest_description": {
