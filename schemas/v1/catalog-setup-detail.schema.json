            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Posture"
        },
        "latest_published_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "latest_purpose": {
          "title": "Latest Purpose",
          "type": "string"
        },
        "latest_requirements_count": {
          "default": 0,
          "minimum": 0,
          "title": "Latest Requirements Count",
          "type": "integer"
        },
        "latest_requires_credentials": {
          "default": false,
          "title": "Latest Requires Credentials",
          "type": "boolean"
        },
