{
  "$defs": {
    "ContentBody": {
      "maxLength": 200000,
      "minLength": 1,
      "type": "string"
    },
    "ContentCommit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "ContentDate": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "ContentDescription": {
      "maxLength": 320,
      "minLength": 1,
      "type": "string"
    },
    "ContentDetail": {
      "additionalProperties": true,
      "description": "Public detail. Repository provenance is exact commit and path only.",
      "properties": {
        "body": {
          "$ref": "#/$defs/ContentBody"
        },
        "content_digest": {
          "$ref": "#/$defs/DigestValue"
        },
        "description": {
          "$ref": "#/$defs/ContentDescription"
        },
        "locale": {
          "$ref": "#/$defs/ContentLocale"
        },
        "published_at": {
          "$ref": "#/$defs/ContentDate"
        },
        "revision_id": {
          "$ref": "#/$defs/RevisionId"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "slug": {
          "$ref": "#/$defs/ContentSlug"
        },
        "source_kind": {
          "$ref": "#/$defs/ContentSourceKind"
        },
        "source_path": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Path"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentCommit"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/ContentTag"
          },
          "maxItems": 12,
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/ContentTitle"
        },
        "type": {
          "$ref": "#/$defs/ContentType"
        }
      },
      "required": [
        "body",
        "content_digest",
        "description",
        "locale",
        "published_at",
        "revision_id",
        "schema_version",
        "slug",
        "source_kind",
        "source_path",
        "source_ref",
        "tags",
        "title",
        "type"
      ],
      "title": "ContentDetail",
      "type": "object"
    },
    "ContentLocale": {
      "enum": [
        "ru",
        "en"
      ],
      "type": "string"
    },
    "ContentSlug": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "ContentSourceKind": {
      "enum": [
        "repository",
        "staff"
      ],
      "type": "string"
    },
    "ContentTag": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
    },
    "ContentTitle": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "ContentType": {
      "enum": [
        "article",
        "blog_post",
        "changelog",
        "release_notes"
      ],
      "type": "string"
    },
    "DigestValue": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "RevisionId": {
      "pattern": "^revision_[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:staff-content-publish-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Staff publication result with the public article pair.",
  "properties": {
    "active_digest": {
      "$ref": "#/$defs/DigestValue"
    },
    "article_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Article Id",
      "type": "string"
    },
    "articles": {
      "additionalProperties": {
        "$ref": "#/$defs/ContentDetail"
      },
      "propertyNames": {
        "$ref": "#/$defs/ContentLocale"
      },
      "title": "Articles",
      "type": "object"
    },
    "revision_ids": {
      "additionalProperties": {
        "$ref": "#/$defs/RevisionId"
      },
      "propertyNames": {
        "$ref": "#/$defs/ContentLocale"
      },
      "title": "Revision Ids",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "active_digest",
    "article_id",
    "articles",
    "revision_ids",
    "schema_version"
  ],
  "title": "StaffContentPublishResponse",
  "type": "object"
}
