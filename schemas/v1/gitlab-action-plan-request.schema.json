{
  "$defs": {
    "DeviceId": {
      "pattern": "^device_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "GitLabProjectId": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "GitLabUsername": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,254}[A-Za-z0-9])?$",
      "type": "string"
    },
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:gitlab-action-plan-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_level": {
      "anyOf": [
        {
          "enum": [
            "guest",
            "reporter",
            "developer",
            "maintainer"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Level"
    },
    "action": {
      "enum": [
        "grant_access",
        "revoke_access",
        "make_public",
        "make_private",
        "create_repository"
      ],
      "title": "Action",
      "type": "string"
    },
    "device_id": {
      "$ref": "#/$defs/DeviceId"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "path": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/GitLabProjectId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recipient": {
      "anyOf": [
        {
          "$ref": "#/$defs/GitLabUsername"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target_visibility": {
      "anyOf": [
        {
          "enum": [
            "private",
            "internal",
            "public"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Visibility"
    }
  },
  "required": [
    "action",
    "device_id",
    "idempotency_key"
  ],
  "title": "GitLabActionPlanRequest",
  "type": "object"
}
