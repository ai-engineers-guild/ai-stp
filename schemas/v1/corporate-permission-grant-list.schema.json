{
  "$defs": {
    "CorporatePermissionGrant": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "grant_id": {
          "title": "Grant Id",
          "type": "string"
        },
        "issuer_account_id": {
          "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Issuer Account Id",
          "type": "string"
        },
        "permission": {
          "title": "Permission",
          "type": "string"
        },
        "principal_type": {
          "enum": [
            "user",
            "service_principal"
          ],
          "title": "Principal Type",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "scope_kind": {
          "enum": [
            "organization",
            "team",
            "project",
            "technology"
          ],
          "title": "Scope Kind",
          "type": "string"
        },
        "service_principal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Principal Id"
        },
        "state": {
          "enum": [
            "active",
            "revoked"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "grant_id",
        "issuer_account_id",
        "permission",
        "principal_type",
        "revision",
        "schema_version",
        "scope_id",
        "scope_kind",
        "service_principal_id",
        "state"
      ],
      "title": "CorporatePermissionGrant",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-permission-grant-list",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/CorporatePermissionGrant"
      },
      "maxItems": 256,
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "schema_version"
  ],
  "title": "CorporatePermissionGrantList",
  "type": "object"
}
