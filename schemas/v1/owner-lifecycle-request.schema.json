{
  "$defs": {
    "OwnerLifecycleAction": {
      "enum": [
        "deprecate",
        "undeprecate"
      ],
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:owner-lifecycle-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Lifecycle transition on an exact owned version.\n\nOwners deprecate or undo deprecation of their versions. Staff moderation\nuses separate actions with an explicit reason and audit event.",
  "properties": {
    "action": {
      "$ref": "#/$defs/OwnerLifecycleAction"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 16,
      "title": "Idempotency Key",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "action",
    "reason",
    "idempotency_key"
  ],
  "title": "OwnerLifecycleRequest",
  "type": "object"
}
