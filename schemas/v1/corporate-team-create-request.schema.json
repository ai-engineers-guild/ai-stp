{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-team-create-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "employee_ids": {
      "items": {
        "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Employee Ids",
      "type": "array"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "lead_account_id": {
      "anyOf": [
        {
          "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lead Account Id"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "project_ids": {
      "items": {
        "pattern": "^remote_project_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Project Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "technology_ids": {
      "items": {
        "pattern": "^technology_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Technology Ids",
      "type": "array"
    }
  },
  "required": [
    "name",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateTeamCreateRequest",
  "type": "object"
}
