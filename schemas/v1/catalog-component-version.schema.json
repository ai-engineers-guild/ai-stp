        "paths",
        "rule_ids",
        "schema_version",
        "severity_max",
        "truncated"
      ],
      "title": "SafetyFindingSummary",
      "type": "object"
    },
    "ScopeAdaptation": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "technical_support_reason": {
                "type": "string"
              }
            },
            "required": [
              "technical_support_reason"
            ]
          },
          "if": {
            "properties": {
              "technical_support": {
                "const": "supported"
              }
            }
          },
          "then": {
            "properties": {
              "technical_support_reason": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "All native facts for one adaptation at one projection scope.",
      "properties": {
        "members": {
          "items": {
            "$ref": "#/$defs/ProjectedMember"
          },
          "maxItems": 8192,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "permissions": {
          "$ref": "#/$defs/Permissions"
        },
        "projection_artifact": {
          "$ref": "#/$defs/NonEmptyArtifactRef"
        },
        "projection_format": {
          "const": "ai-stp-adaptation-projection/1",
          "title": "Projection Format",
          "type": "string"
        },
        "projection_kind": {
          "$ref": "#/$defs/ProjectionKind"
        },
        "provider_component_kind": {
          "$ref": "#/$defs/ComponentType"
        },
        "required_surface": {
          "$ref": "#/$defs/ProviderSurfaceRef"
        },
        "scope": {
          "$ref": "#/$defs/TargetScope"
        },
        "semantic_losses": {
          "items": {
            "type": "string"
          },
          "title": "Semantic Losses",
          "type": "array",
          "uniqueItems": true
        },
        "supported_arch": {
          "items": {
            "$ref": "#/$defs/SupportedArch"
          },
          "title": "Supported Arch",
          "type": "array",
          "uniqueItems": true
        },
        "supported_harness_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1f]+$",
            "type": "string"
          },
          "title": "Supported Harness Versions",
          "type": "array",
          "uniqueItems": true
        },
        "supported_os": {
          "items": {
            "$ref": "#/$defs/SupportedOs"
          },
          "title": "Supported Os",
          "type": "array",
          "uniqueItems": true
        },
        "technical_support": {
          "$ref": "#/$defs/TechnicalSupport"
        },
        "technical_support_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technical Support Reason"
        }
      },
      "required": [
        "scope",
        "projection_format",
        "projection_artifact",
        "provider_component_kind",
        "projection_kind",
        "required_surface",
        "members",
        "technical_support"
      ],
      "title": "ScopeAdaptation",
      "type": "object"
    },
    "SupportArchitecture": {
      "enum": [
        "x86_64",
        "arm64"
      ],
      "type": "string"
    },
    "SupportEvidenceResult": {
      "enum": [
        "passed",
        "warning",
        "failed",
        "degraded",
        "not_run",
        "expired"
