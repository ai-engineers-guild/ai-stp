          "title": "Total Countable",
          "type": "integer"
        },
        "warning": {
          "default": 0,
          "minimum": 0,
          "title": "Warning",
          "type": "integer"
        }
      },
      "required": [
        "checks",
        "checks_passed_percent",
        "coverage_complete",
        "failed",
        "not_run",
        "passed",
        "schema_version",
        "status",
        "total_countable",
        "warning"
      ],
      "title": "SafetyChecksSummary",
      "type": "object"
    },
    "SafetyFindingSummary": {
      "additionalProperties": true,
      "description": "Bounded public identifiers for findings; never scanned content.",
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "paths": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Paths",
          "type": "array"
        },
        "rule_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
