{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed artifact bytes: digest and size.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BoundedNativeId": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f]+$",
      "type": "string"
    },
    "CapabilityId": {
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "type": "string"
    },
    "CatalogSupport": {
      "additionalProperties": true,
      "description": "Provider support status, separate from object trust and verification.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/CatalogSupportEvidence"
          },
          "maxItems": 32,
          "title": "Evidence",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/SupportState"
        },
        "tier": {
          "$ref": "#/$defs/SupportTier"
        }
      },
      "required": [
        "evidence",
        "schema_version",
        "state",
        "tier"
      ],
      "title": "CatalogSupport",
      "type": "object"
    },
    "CatalogSupportEvidence": {
      "additionalProperties": true,
      "description": "Safe public summary of one provider support check (SPEC-033, ADR-0072).",
      "properties": {
        "architecture": {
          "$ref": "#/$defs/SupportArchitecture"
        },
        "check_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "operating_system": {
          "$ref": "#/$defs/SupportOperatingSystem"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "release_reference": {
          "pattern": "^(?:[0-9a-f]{40,64}|sha256:[0-9a-f]{64})$",
          "title": "Release Reference",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/SupportEvidenceResult"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/SupportEvidenceSource"
        }
      },
      "required": [
        "architecture",
        "check_id",
        "expires_at",
        "mandatory",
        "observed_at",
        "operating_system",
        "policy_version",
        "provider_id",
        "provider_version",
        "release_reference",
        "result",
        "schema_version",
        "source"
      ],
      "title": "CatalogSupportEvidence",
      "type": "object"
    },
    "CatalogTrust": {
      "additionalProperties": true,
      "description": "Why a published version may appear in results, and on whose evidence.\n\nThe two verification flags are independent axes (ADR-0016) and neither may\nbe computed from the other. `authoritative` additionally requires both, and\nthat implication is enforced below — enforcing it is not the same as\nderiving one axis from the other, and a client must still read the flags.",
      "properties": {
        "author_verified": {
          "title": "Author Verified",
          "type": "boolean"
        },
        "component_verified": {
          "title": "Component Verified",
          "type": "boolean"
        },
        "trust_lane": {
          "$ref": "#/$defs/CatalogTrustLane"
        }
      },
      "required": [
        "author_verified",
        "component_verified",
        "trust_lane"
      ],
      "title": "CatalogTrust",
      "type": "object"
    },
    "CatalogTrustLane": {
      "enum": [
        "authoritative",
        "experimental"
      ],
      "type": "string"
    },
    "CatalogUsageMetrics": {
      "additionalProperties": true,
      "description": "Server aggregate of public detail views and completed artifact bytes.\n\nAbsence of this object means the feature is off or the value is unavailable,\nnot zero. Download is not install success.",
      "properties": {
        "artifact_downloads_count": {
          "minimum": 0,
          "title": "Artifact Downloads Count",
          "type": "integer"
        },
        "detail_views_count": {
          "minimum": 0,
          "title": "Detail Views Count",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_downloads_count",
        "detail_views_count",
        "schema_version"
      ],
      "title": "CatalogUsageMetrics",
      "type": "object"
    },
    "CheckResult": {
      "enum": [
        "passed",
        "warning",
        "failed",
        "degraded",
        "not_run",
        "not_applicable",
        "skipped",
        "running"
      ],
      "type": "string"
    },
    "ChecksStatus": {
      "enum": [
        "pending",
        "available",
        "empty",
        "incomplete"
      ],
      "type": "string"
    },
    "ComponentAdaptation": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "transform": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "implementation_mode": {
                "const": "derived"
              }
            }
          },
          "then": {
            "properties": {
              "transform": {
                "type": "object"
              }
            },
            "required": [
              "transform"
            ]
          }
        }
      ],
      "description": "One immutable harness-native implementation of a logical component.",
      "properties": {
        "adaptation_id": {
          "pattern": "^adaptation_[0-9a-f]{64}$",
          "title": "Adaptation Id",
          "type": "string"
        },
        "harness_id": {
          "$ref": "#/$defs/HarnessId"
        },
        "implementation_mode": {
          "$ref": "#/$defs/ImplementationMode"
        },
        "logical_component_type": {
          "$ref": "#/$defs/ComponentType"
        },
        "scope_adaptations": {
          "items": {
            "$ref": "#/$defs/ScopeAdaptation"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Scope Adaptations",
          "type": "array"
        },
        "source_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransformRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "adaptation_id",
        "harness_id",
        "implementation_mode",
        "logical_component_type",
        "scope_adaptations"
      ],
      "title": "ComponentAdaptation",
      "type": "object"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "description": "Exact reference to a component version, optionally to one realization.",
      "properties": {
        "passport_digest": {
          "$ref": "#/$defs/PassportDigest"
        },
        "stable_id": {
          "pattern": "^component_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Stable Id",
          "type": "string"
        },
        "variant_id": {
          "anyOf": [
            {
              "pattern": "^variant_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Id"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "stable_id",
        "version",
        "passport_digest"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "ComponentType": {
      "enum": [
        "instruction",
        "skill",
        "mcp",
        "hook",
        "command",
        "agent",
        "plugin",
        "setting"
      ],
      "type": "string"
    },
    "ComponentVersionPassport": {
      "additionalProperties": true,
      "description": "Immutable component version passport.",
      "properties": {
        "adaptations": {
          "items": {
            "$ref": "#/$defs/ComponentAdaptation"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Adaptations",
          "type": "array"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "compatibility_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Compatibility Evidence Refs",
          "type": "array"
        },
        "component_type": {
          "$ref": "#/$defs/ComponentType"
        },
        "conflicts": {
          "$ref": "#/$defs/Conflicts"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "external_endpoints": {
          "items": {
            "pattern": "^https://[^\\s]+$",
            "type": "string"
          },
          "title": "External Endpoints",
          "type": "array"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Facts",
          "type": "object"
        },
        "kind": {
          "const": "component",
          "default": "component",
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/LicenseInfo"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "origin_harness_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "owner_id": {
          "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Owner Id",
          "type": "string"
        },
        "parent_revision_ids": {
          "items": {
            "$ref": "#/$defs/RevisionId"
          },
          "title": "Parent Revision Ids",
          "type": "array"
        },
        "permissions": {
          "$ref": "#/$defs/Permissions"
        },
        "provides_capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityId"
          },
          "title": "Provides Capabilities",
          "type": "array"
        },
        "required_env": {
          "items": {
            "$ref": "#/$defs/EnvVarRequirement"
          },
          "title": "Required Env",
          "type": "array"
        },
        "requires_authorization": {
          "default": "none",
          "enum": [
            "none",
            "user_account",
            "external_service"
          ],
          "title": "Requires Authorization",
          "type": "string"
        },
        "requires_capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityId"
          },
          "title": "Requires Capabilities",
          "type": "array"
        },
        "requires_components": {
          "items": {
            "$ref": "#/$defs/ComponentRef"
          },
          "title": "Requires Components",
          "type": "array"
        },
        "requires_credentials": {
          "default": false,
          "title": "Requires Credentials",
          "type": "boolean"
        },
        "revision_id": {
          "$ref": "#/$defs/RevisionId"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stable_id": {
          "title": "Stable Id",
          "type": "string"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/TagId"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "visibility": {
          "default": "private",
          "enum": [
            "private",
            "public"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "adaptations",
        "artifact",
        "compatibility_evidence_refs",
        "component_type",
        "conflicts",
        "created_at",
        "description",
        "external_endpoints",
        "facts",
        "kind",
        "license",
        "name",
        "origin_harness_id",
        "owner_id",
        "parent_revision_ids",
        "permissions",
        "provides_capabilities",
        "required_env",
        "requires_authorization",
        "requires_capabilities",
        "requires_components",
        "requires_credentials",
        "revision_id",
        "schema_version",
        "source",
        "stable_id",
        "tags",
        "version",
        "visibility"
      ],
      "title": "ComponentVersionPassport",
      "type": "object"
    },
    "Conflicts": {
      "additionalProperties": false,
      "description": "Declared conflicts by native surface.",
      "properties": {
        "agents": {
          "items": {
            "type": "string"
          },
          "title": "Agents",
          "type": "array"
        },
        "commands": {
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "hooks": {
          "items": {
            "type": "string"
          },
          "title": "Hooks",
          "type": "array"
        },
        "mcp": {
          "items": {
            "type": "string"
          },
          "title": "Mcp",
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "plugins": {
          "items": {
            "type": "string"
          },
          "title": "Plugins",
          "type": "array"
        }
      },
      "title": "Conflicts",
      "type": "object"
    },
    "EnvVarRequirement": {
      "additionalProperties": false,
      "description": "Required environment variable: name and purpose, never a value.",
      "properties": {
        "name": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "name",
        "purpose"
      ],
      "title": "EnvVarRequirement",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": true,
      "description": "One passport fact: value, provenance axes and bounded source links.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "confirmation": {
          "$ref": "#/$defs/FactConfirmation"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "$ref": "#/$defs/FactOrigin"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Source Refs",
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "value",
        "origin",
        "confirmation"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FactConfirmation": {
      "enum": [
        "none",
        "user_confirmed"
      ],
      "type": "string"
    },
    "FactOrigin": {
      "enum": [
        "declared",
        "observed",
        "derived",
        "imported"
      ],
      "type": "string"
    },
    "FindingSeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "GitSource": {
      "additionalProperties": false,
      "description": "Exact public origin: repository, commit and component root subpath.",
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "pattern": "^https://[^\\s]+$",
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "path"
      ],
      "title": "GitSource",
      "type": "object"
    },
    "HarnessId": {
      "enum": [
        "claude-code",
        "codex",
        "pi",
        "opencode",
        "grok-build",
        "cursor",
        "antigravity"
      ],
      "type": "string"
    },
    "ImplementationMode": {
      "enum": [
        "derived",
        "native"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "LicenseInfo": {
      "additionalProperties": false,
      "description": "License identity and the redistribution decision.",
      "properties": {
        "redistribution_allowed": {
          "title": "Redistribution Allowed",
          "type": "boolean"
        },
        "spdx_id": {
          "title": "Spdx Id",
          "type": "string"
        }
      },
      "required": [
        "spdx_id",
        "redistribution_allowed"
      ],
      "title": "LicenseInfo",
      "type": "object"
    },
    "NonEmptyArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed bytes for an artifact that must contain a projection.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 67108864,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes"
      ],
      "title": "NonEmptyArtifactRef",
      "type": "object"
    },
    "OwnershipMode": {
      "enum": [
        "whole",
        "contribution"
      ],
      "type": "string"
    },
    "PassportDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "PermissionClaim": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f]+$",
      "type": "string"
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "Declared file, network and process permissions.",
      "properties": {
        "filesystem": {
          "items": {
            "$ref": "#/$defs/PermissionClaim"
          },
          "title": "Filesystem",
          "type": "array",
          "uniqueItems": true
        },
        "network": {
          "items": {
            "$ref": "#/$defs/PermissionClaim"
          },
          "title": "Network",
          "type": "array",
          "uniqueItems": true
        },
        "process": {
          "items": {
            "$ref": "#/$defs/PermissionClaim"
          },
          "title": "Process",
          "type": "array",
          "uniqueItems": true
        }
      },
      "title": "Permissions",
      "type": "object"
    },
    "ProjectedMember": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "content_artifact": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "object_type": {
                "const": "file"
              }
            }
          },
          "then": {
            "properties": {
              "content_artifact": {
                "type": "object"
              }
            },
            "required": [
              "content_artifact"
            ]
          }
        }
      ],
      "description": "One canonical projected path and the provider semantics it requires.",
      "properties": {
        "content_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_format": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Content Format",
          "type": "string"
        },
        "mode": {
          "maximum": 511,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        },
        "native_ids": {
          "items": {
            "$ref": "#/$defs/BoundedNativeId"
          },
          "title": "Native Ids",
          "type": "array",
          "uniqueItems": true
        },
        "object_type": {
          "$ref": "#/$defs/ProjectedObjectType"
        },
        "ownership": {
          "$ref": "#/$defs/OwnershipMode"
        },
        "ownership_key": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Key"
        },
        "parser_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Id"
        },
        "path": {
          "$ref": "#/$defs/RelativeProjectionPath"
        },
        "withdrawal_semantics": {
          "$ref": "#/$defs/WithdrawalSemantics"
        },
        "write_semantics": {
          "$ref": "#/$defs/WriteSemantics"
        }
      },
      "required": [
        "path",
        "object_type",
        "mode",
        "content_format",
        "ownership",
        "write_semantics",
        "withdrawal_semantics"
      ],
      "title": "ProjectedMember",
      "type": "object"
    },
    "ProjectedObjectType": {
      "enum": [
        "file",
        "directory"
      ],
      "type": "string"
    },
    "ProjectionKind": {
      "enum": [
        "marketplace",
        "plugin",
        "native_files",
        "package"
      ],
      "type": "string"
    },
    "ProviderSurfaceRef": {
      "additionalProperties": false,
      "description": "Exact provider capability identity required by one projection scope.",
      "properties": {
        "bundle_format": {
          "pattern": "^[a-z0-9][a-z0-9._/-]*$",
          "title": "Bundle Format",
          "type": "string"
        },
        "profile_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profile Digest",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-z0-9][a-z0-9._/-]*$",
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_digest",
        "bundle_format"
      ],
      "title": "ProviderSurfaceRef",
      "type": "object"
    },
    "PublicLifecycle": {
      "enum": [
        "active",
        "deprecated",
        "blocked"
      ],
      "type": "string"
    },
    "RelativeProjectionPath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f])[^/].*[^/]$|^[^/\\\\.\\u0000-\\u001f]$",
      "type": "string"
    },
    "RevisionId": {
      "pattern": "^revision_[0-9a-f]{64}$",
      "type": "string"
    },
    "SafetyCheckEntry": {
      "additionalProperties": true,
      "description": "One check line on an audit list.",
      "properties": {
        "check_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "family": {
          "default": "",
          "maxLength": 64,
          "title": "Family",
          "type": "string"
        },
        "finding_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafetyFindingSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result": {
          "$ref": "#/$defs/CheckResult"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "default": "platform_safety_scan",
          "maxLength": 64,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "family",
        "finding_summary",
        "mandatory",
        "reason",
        "result",
        "schema_version",
        "source"
      ],
      "title": "SafetyCheckEntry",
      "type": "object"
    },
    "SafetyChecksSummary": {
      "additionalProperties": true,
      "description": "Card/detail projection for checks percent and status.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/SafetyCheckEntry"
          },
          "maxItems": 128,
          "title": "Checks",
          "type": "array"
        },
        "checks_passed_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checks Passed Percent"
        },
        "coverage_complete": {
          "default": true,
          "title": "Coverage Complete",
          "type": "boolean"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "not_run": {
          "default": 0,
          "minimum": 0,
          "title": "Not Run",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ChecksStatus"
        },
        "total_countable": {
          "default": 0,
