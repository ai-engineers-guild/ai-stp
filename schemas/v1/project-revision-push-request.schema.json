{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:project-revision-push-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One explicit content-addressed project revision push.",
  "properties": {
    "authorization_revision": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Authorization Revision",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[A-Za-z0-9._~-]{8,128}$",
      "title": "Event Id",
      "type": "string"
    },
    "expected_head_revision_id": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Head Revision Id"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "operation": {
      "enum": [
        "upsert",
        "tombstone"
      ],
      "title": "Operation",
      "type": "string"
    },
    "parent_revision_ids": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 2,
      "title": "Parent Revision Ids",
      "type": "array"
    },
    "projection": {
      "additionalProperties": true,
      "title": "Projection",
      "type": "object"
    },
    "revision_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "revision_id",
    "parent_revision_ids",
    "operation",
    "content_digest",
    "projection",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "ProjectRevisionPushRequest",
  "type": "object"
}
