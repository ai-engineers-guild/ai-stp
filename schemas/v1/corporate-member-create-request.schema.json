{
  "$defs": {
    "CorporateMemberCatalogAssignment": {
      "additionalProperties": false,
      "properties": {
        "object_kind": {
          "const": "component",
          "title": "Object Kind",
          "type": "string"
        },
        "stable_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "object_kind",
        "stable_id",
        "version"
      ],
      "title": "CorporateMemberCatalogAssignment",
      "type": "object"
    },
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-member-create-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "anyOf": [
        {
          "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Id"
    },
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "catalog_assignments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CorporateMemberCatalogAssignment"
      },
      "maxItems": 64,
      "title": "Catalog Assignments",
      "type": "array"
    },
    "display_name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "email": {
      "anyOf": [
        {
          "maxLength": 320,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Email"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "job_title_id": {
      "anyOf": [
        {
          "pattern": "^job_title_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Title Id"
    },
    "project_ids": {
      "items": {
        "pattern": "^remote_project_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Project Ids",
      "type": "array"
    },
    "role": {
      "description": "Tenant-local role name.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "team_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Team Ids",
      "type": "array"
    }
  },
  "required": [
    "display_name",
    "role",
    "team_ids",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateMemberCreateRequest",
  "type": "object"
}
