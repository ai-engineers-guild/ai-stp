{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-member-create-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "anyOf": [
        {
          "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Id"
    },
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "display_name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "email": {
      "anyOf": [
        {
          "maxLength": 320,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Email"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "role": {
      "enum": [
        "superadmin",
        "lead",
        "staff"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "display_name",
    "role",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateMemberCreateRequest",
  "type": "object"
}
