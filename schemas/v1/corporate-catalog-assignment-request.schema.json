{
  "$defs": {
    "HarnessId": {
      "enum": [
        "claude-code",
        "codex",
        "pi",
        "opencode",
        "grok-build",
        "cursor",
        "antigravity"
      ],
      "type": "string"
    },
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-catalog-assignment-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Assign a stable catalog line without granting access or installing it.",
  "properties": {
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "object_kind": {
      "enum": [
        "setup",
        "component"
      ],
      "title": "Object Kind",
      "type": "string"
    },
    "passport_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Passport Digest"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selector": {
      "default": "exact",
      "enum": [
        "exact",
        "latest"
      ],
      "title": "Selector",
      "type": "string"
    },
    "stable_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Stable Id",
      "type": "string"
    },
    "state": {
      "default": "current",
      "enum": [
        "current",
        "retired"
      ],
      "title": "State",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_kind": {
      "enum": [
        "employee",
        "team",
        "project",
        "technology",
        "organization"
      ],
      "title": "Subject Kind",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    }
  },
  "required": [
    "subject_kind",
    "subject_id",
    "object_kind",
    "stable_id",
    "expected_revision",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateCatalogAssignmentRequest",
  "type": "object"
}
