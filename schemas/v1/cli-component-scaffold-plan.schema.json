{
  "$defs": {
    "ComponentGeneratorVersion": {
      "enum": [
        "ai-stp/1",
        "ai-stp/2",
        "ai-stp/3",
        "ai-stp/4",
        "ai-stp/5",
        "ai-stp/6"
      ],
      "type": "string"
    },
    "ComponentScaffoldFile": {
      "additionalProperties": false,
      "description": "One exact regular file produced by a scaffold plan.",
      "properties": {
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "mode": {
          "const": 384,
          "default": 384,
          "title": "Mode",
          "type": "integer"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest",
        "byte_length"
      ],
      "title": "ComponentScaffoldFile",
      "type": "object"
    },
    "ComponentTemplateDescriptor": {
      "additionalProperties": false,
      "description": "Exact generator choice recorded inside every scaffold.",
      "properties": {
        "additional_harnesses": {
          "items": {
            "type": "string"
          },
          "title": "Additional Harnesses",
          "type": "array"
        },
        "component_type": {
          "$ref": "#/$defs/ComponentType"
        },
        "executable": {
          "title": "Executable",
          "type": "boolean"
        },
        "generator_version": {
          "$ref": "#/$defs/ComponentGeneratorVersion",
          "default": "ai-stp/6"
        },
        "harness_variant": {
          "anyOf": [
            {
              "const": "portable",
              "type": "string"
            },
            {
              "$ref": "#/$defs/HarnessId"
            }
          ],
          "title": "Harness Variant"
        },
        "language": {
          "enum": [
            "none",
            "python",
            "typescript",
            "javascript",
            "rust",
            "go",
            "dart-flutter"
          ],
          "title": "Language",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "standard_family": {
          "anyOf": [
            {
              "const": "ai-stp-standard/1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Family"
        },
        "template_version": {
          "$ref": "#/$defs/ComponentTemplateVersion",
          "default": "component-scaffold/6"
        }
      },
      "required": [
        "component_type",
        "language",
        "harness_variant",
        "executable"
      ],
      "title": "ComponentTemplateDescriptor",
      "type": "object"
    },
    "ComponentTemplateVersion": {
      "enum": [
        "component-scaffold/1",
        "component-scaffold/2",
        "component-scaffold/3",
        "component-scaffold/4",
        "component-scaffold/5",
        "component-scaffold/6"
      ],
      "type": "string"
    },
    "ComponentType": {
      "enum": [
        "instruction",
        "skill",
        "mcp",
        "hook",
        "command",
        "agent",
        "plugin",
        "setting"
      ],
      "type": "string"
    },
    "HarnessId": {
      "enum": [
        "claude-code",
        "codex",
        "pi",
        "opencode",
        "grok-build",
        "cursor",
        "antigravity"
      ],
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-component-scaffold-plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed preview of a complete authoring directory.",
  "properties": {
    "component_name": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Component Name",
      "type": "string"
    },
    "descriptor": {
      "$ref": "#/$defs/ComponentTemplateDescriptor"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ComponentScaffoldFile"
      },
      "minItems": 6,
      "title": "Files",
      "type": "array"
    },
    "output": {
      "minLength": 1,
      "title": "Output",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^scaffold_plan_[0-9a-f]{24}$",
      "title": "Plan Id",
      "type": "string"
    },
    "publication_ready": {
      "const": false,
      "default": false,
      "title": "Publication Ready",
      "type": "boolean"
    },
    "requires_exact_source_before_publication": {
      "const": true,
      "default": true,
      "title": "Requires Exact Source Before Publication",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "plan_id",
    "plan_digest",
    "output",
    "component_name",
    "descriptor",
    "files"
  ],
  "title": "ComponentScaffoldPlan",
  "type": "object"
}
