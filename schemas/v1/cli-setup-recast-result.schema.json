{
  "$id": "urn:ai-stp:schema:v1:cli-setup-recast-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A newly recorded setup recast from an exact source version.",
  "properties": {
    "created": {
      "title": "Created",
      "type": "boolean"
    },
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "passport_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Passport Digest",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "setup_id": {
      "minLength": 1,
      "title": "Setup Id",
      "type": "string"
    },
    "source_setup_id": {
      "minLength": 1,
      "title": "Source Setup Id",
      "type": "string"
    },
    "source_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Source Version",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "setup_id",
    "version",
    "source_setup_id",
    "source_version",
    "created_at",
    "passport_digest",
    "plan_digest",
    "created"
  ],
  "title": "SetupRecastResult",
  "type": "object"
}
