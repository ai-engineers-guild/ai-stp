{
  "$defs": {
    "CorporateBinding": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "principal_type": {
          "default": "user",
          "enum": [
            "user",
            "service_principal"
          ],
          "title": "Principal Type",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "role": {
          "enum": [
            "superadmin",
            "lead",
            "staff"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "scope_kind": {
          "enum": [
            "system",
            "organization",
            "team",
            "project",
            "technology",
            "catalog_object",
            "telemetry"
          ],
          "title": "Scope Kind",
          "type": "string"
        },
        "service_principal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Principal Id"
        },
        "state": {
          "enum": [
            "active",
            "revoked"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "binding_id",
        "principal_type",
        "revision",
        "role",
        "schema_version",
        "scope_id",
        "scope_kind",
        "service_principal_id",
        "state"
      ],
      "title": "CorporateBinding",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-membership-assignment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "account_id": {
      "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Account Id",
      "type": "string"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/CorporateBinding"
      },
      "maxItems": 2,
      "title": "Bindings",
      "type": "array"
    },
    "operation": {
      "default": "assign",
      "enum": [
        "assign",
        "remove"
      ],
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Project Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Team Id"
    },
    "team_role": {
      "enum": [
        "lead",
        "staff"
      ],
      "title": "Team Role",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "bindings",
    "operation",
    "project_id",
    "schema_version",
    "team_id",
    "team_role"
  ],
  "title": "CorporateMembershipAssignment",
  "type": "object"
}
