{
  "$defs": {
    "GraphNode": {
      "additionalProperties": true,
      "description": "One exact version the closure holds.",
      "properties": {
        "depth": {
          "minimum": 0,
          "title": "Depth",
          "type": "integer"
        },
        "passport_digest": {
          "minLength": 1,
          "title": "Passport Digest",
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GraphReference"
          },
          "title": "Requires",
          "type": "array"
        },
        "revision_id": {
          "minLength": 1,
          "title": "Revision Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stable_id": {
          "minLength": 1,
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "depth",
        "passport_digest",
        "requires",
        "revision_id",
        "schema_version",
        "stable_id",
        "version"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphReference": {
      "additionalProperties": true,
      "description": "One exact edge inside a closure (`docs/contracts/setup-graph.md`).\n\nAll three fields are required together. A digest without a version cannot be\nlooked up and a version without a digest cannot be verified, so either alone\nwould be half a statement the resolver could still act on.",
      "properties": {
        "passport_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Passport Digest",
          "type": "string"
        },
        "required_by": {
          "default": "",
          "title": "Required By",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stable_id": {
          "minLength": 1,
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "passport_digest",
        "required_by",
        "schema_version",
        "stable_id",
        "version"
      ],
      "title": "GraphReference",
      "type": "object"
    },
    "GraphRefusal": {
      "additionalProperties": true,
      "description": "One reason a closure could not be resolved.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Details",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "code",
        "details",
        "schema_version",
        "summary"
      ],
      "title": "GraphRefusal",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-setup-graph",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The exact dependency closure of a composition (`SPEC-006` REQ-605).\n\n`nodes` is empty whenever `resolved` is false, and that is deliberate:\n`REQ-608` says an unresolved closure blocks, and returning the part that did\nresolve would read as \"almost composed\". A composition missing a dependency\nis not composed at all.",
  "properties": {
    "max_depth": {
      "minimum": 1,
      "title": "Max Depth",
      "type": "integer"
    },
    "max_nodes": {
      "minimum": 1,
      "title": "Max Nodes",
      "type": "integer"
    },
    "nodes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "order": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Order",
      "type": "array"
    },
    "refusals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphRefusal"
      },
      "title": "Refusals",
      "type": "array"
    },
    "resolved": {
      "title": "Resolved",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "max_depth",
    "max_nodes",
    "nodes",
    "order",
    "refusals",
    "resolved",
    "schema_version"
  ],
  "title": "SetupGraph",
  "type": "object"
}
