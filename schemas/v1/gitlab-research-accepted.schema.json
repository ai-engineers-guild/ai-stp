{
  "$id": "urn:ai-stp:schema:v1:gitlab-research-accepted",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "job_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "organization_id": {
      "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Organization Id",
      "type": "string"
    },
    "scan_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "maxLength": 32,
      "minLength": 1,
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "organization_id",
    "scan_id",
    "schema_version",
    "state"
  ],
  "title": "GitLabResearchAccepted",
  "type": "object"
}
