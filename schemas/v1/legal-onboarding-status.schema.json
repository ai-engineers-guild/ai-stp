{
  "$defs": {
    "AccountId": {
      "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:legal-onboarding-status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Exact current revisions an authenticated pending account must accept.",
  "properties": {
    "account_id": {
      "$ref": "#/$defs/AccountId"
    },
    "account_status": {
      "enum": [
        "onboarding_pending",
        "active"
      ],
      "title": "Account Status",
      "type": "string"
    },
    "personal_data_consent_revision_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Personal Data Consent Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "service_rules_revision_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Service Rules Revision Id",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "account_status",
    "personal_data_consent_revision_id",
    "schema_version",
    "service_rules_revision_id"
  ],
  "title": "LegalOnboardingStatus",
  "type": "object"
}
