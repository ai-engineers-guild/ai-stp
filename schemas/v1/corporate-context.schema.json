        },
        "available_actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Available Actions",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "effective_assignments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CorporateCatalogAssignment"
          },
          "maxItems": 256,
          "title": "Effective Assignments",
          "type": "array"
        },
        "effective_permissions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Effective Permissions",
          "type": "array"
        },
        "governance_history": {
          "default": [],
          "items": {
