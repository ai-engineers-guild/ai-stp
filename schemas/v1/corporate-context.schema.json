  "$id": "urn:ai-stp:schema:v1:corporate-context",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/CorporateBinding"
      },
      "maxItems": 256,
      "title": "Bindings",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "title": "Capabilities",
      "type": "array"
    },
    "member": {
      "$ref": "#/$defs/CorporateMember"
    },
    "organization": {
      "$ref": "#/$defs/CorporateOrganization"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/CorporateProjectView"
      },
      "maxItems": 256,
      "title": "Projects",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "teams": {
      "items": {
        "$ref": "#/$defs/CorporateTeamView"
      },
      "maxItems": 256,
      "title": "Teams",
      "type": "array"
    }
  },
  "required": [
    "bindings",
    "capabilities",
    "member",
    "organization",
    "projects",
    "schema_version",
    "teams"
  ],
  "title": "CorporateContext",
  "type": "object"
}
