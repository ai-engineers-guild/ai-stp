            "type": "string"
          },
          "maxItems": 128,
          "title": "Available Actions",
          "type": "array"
        },
        "lifecycle": {
          "anyOf": [
            {
              "enum": [
                "active",
                "deprecated",
                "archived",
                "deleted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lifecycle"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Organization Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "restore_lifecycle": {
          "anyOf": [
            {
              "enum": [
                "active",
                "deprecated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restore Lifecycle"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "enum": [
            "active",
            "archived"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "available_actions",
        "name",
        "organization_id",
        "project_id",
        "revision",
        "schema_version",
        "state"
      ],
      "title": "CorporateProjectView",
      "type": "object"
    },
    "CorporateTeamCatalogObject": {
      "additionalProperties": true,
