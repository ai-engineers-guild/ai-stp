        }
      },
      "required": [
        "authorization_revision",
        "display_name",
        "organization_id",
        "schema_version",
        "state"
      ],
      "title": "CorporateOrganization",
      "type": "object"
    },
    "CorporateProjectView": {
      "additionalProperties": true,
      "properties": {
        "available_actions": {
          "default": [],
