{
  "$defs": {
    "CorporateBinding": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "principal_type": {
          "default": "user",
          "enum": [
            "user",
            "service_principal"
          ],
          "title": "Principal Type",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "role": {
          "description": "Tenant-local role name.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "scope_kind": {
          "enum": [
            "system",
            "organization",
            "team",
            "project",
            "technology",
            "catalog_object",
            "telemetry"
          ],
          "title": "Scope Kind",
          "type": "string"
        },
        "service_principal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Principal Id"
        },
        "state": {
          "enum": [
            "active",
            "revoked"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "binding_id",
        "principal_type",
        "revision",
        "role",
        "schema_version",
        "scope_id",
        "scope_kind",
        "service_principal_id",
        "state"
      ],
      "title": "CorporateBinding",
      "type": "object"
    },
    "CorporateCatalogAssignment": {
      "additionalProperties": true,
      "properties": {
        "assignment_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Assignment Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "object_kind": {
          "enum": [
            "setup",
            "component"
          ],
          "title": "Object Kind",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Organization Id",
          "type": "string"
        },
        "passport_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passport Digest"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "selector": {
          "default": "exact",
          "enum": [
            "exact",
            "latest"
          ],
          "title": "Selector",
          "type": "string"
        },
        "source_team_id": {
          "anyOf": [
            {
              "pattern": "^operation_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Team Id"
        },
        "stable_id": {
          "title": "Stable Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "current",
            "retired"
          ],
          "title": "State",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "employee",
            "team",
            "project",
            "technology",
            "organization"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "assignment_id",
        "display_name",
        "harness",
        "object_kind",
        "organization_id",
        "passport_digest",
        "revision",
        "schema_version",
        "selector",
        "source_team_id",
        "stable_id",
        "state",
        "subject_id",
        "subject_kind",
        "version"
      ],
      "title": "CorporateCatalogAssignment",
      "type": "object"
    },
    "CorporateMember": {
      "additionalProperties": true,
