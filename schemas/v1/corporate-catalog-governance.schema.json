    "CorporateAuditEntry": {
      "additionalProperties": true,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "actor_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor Account Id"
        },
        "actor_id": {
          "anyOf": [
