        "action",
        "actor_account_id",
        "actor_id",
        "actor_type",
        "audit_id",
        "created_at",
        "effective_role_bindings",
        "outcome",
        "payload",
        "reason",
        "request_id",
        "schema_version",
        "target_id",
        "target_table"
