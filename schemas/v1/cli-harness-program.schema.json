{
  "$defs": {
    "HarnessProgramArtifact": {
      "additionalProperties": true,
      "description": "One archive a program plan named, as the plan named it.\n\nRepeated here rather than summarised because the consumer fetched exactly\nthis and an agent reading the result may want to check the same bytes\nitself. `entry_point` is relative to the prefix and is the path the provider\nexposes there — not a path inside the archive.",
      "properties": {
        "byte_length": {
          "exclusiveMinimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "entry_point": {
          "minLength": 1,
          "title": "Entry Point",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "byte_length",
        "entry_point",
        "platform",
        "schema_version",
        "sha256",
        "url"
      ],
      "title": "HarnessProgramArtifact",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-harness-program",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The outcome of one program lifecycle operation (`ADR-0122`).\n\nThe subject is the harness program under `--prefix`, not the configuration\nin `--target`. `state` is what the provider reported after the effect, and\n`verified` is the only state that says the program is installed and its\nidentity confirmed.\n\n`operation_id` names the journal entry, which is the same journal a setup\ninstallation uses: the state machine, the backup and the plan digest do not\nchange with the subject.",
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HarnessProgramArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "effects": {
      "items": {
        "type": "string"
      },
      "title": "Effects",
      "type": "array"
    },
    "executable": {
      "default": "",
      "title": "Executable",
      "type": "string"
    },
    "harness_id": {
      "minLength": 1,
      "title": "Harness Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "software_install",
        "software_update",
        "software_remove"
      ],
      "title": "Operation",
      "type": "string"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "prefix": {
      "minLength": 1,
      "title": "Prefix",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "minLength": 1,
      "title": "State",
      "type": "string"
    },
    "version": {
      "default": "",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "artifacts",
    "effects",
    "executable",
    "harness_id",
    "operation",
    "operation_id",
    "plan_digest",
    "prefix",
    "schema_version",
    "state",
    "version"
  ],
  "title": "HarnessProgram",
  "type": "object"
}
