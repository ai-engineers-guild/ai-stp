{
  "$id": "urn:ai-stp:schema:v1:runtime-usage-ingest-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Per-batch bookkeeping; the server never returns event content.",
  "properties": {
    "accepted": {
      "minimum": 0,
      "title": "Accepted",
      "type": "integer"
    },
    "accepted_ids": {
      "items": {
        "maxLength": 80,
        "minLength": 8,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,79}$",
        "type": "string"
      },
      "title": "Accepted Ids",
      "type": "array"
    },
    "duplicate_ids": {
      "items": {
        "maxLength": 80,
        "minLength": 8,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,79}$",
        "type": "string"
      },
      "title": "Duplicate Ids",
      "type": "array"
    },
    "duplicates": {
      "minimum": 0,
      "title": "Duplicates",
      "type": "integer"
    },
    "rejected": {
      "minimum": 0,
      "title": "Rejected",
      "type": "integer"
    },
    "rejected_ids": {
      "items": {
        "maxLength": 80,
        "minLength": 8,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,79}$",
        "type": "string"
      },
      "title": "Rejected Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "accepted",
    "accepted_ids",
    "duplicate_ids",
    "duplicates",
    "rejected",
    "rejected_ids",
    "schema_version"
  ],
  "title": "RuntimeUsageIngestResult",
  "type": "object"
}
