{
  "$defs": {
    "ComponentType": {
      "enum": [
        "instruction",
        "skill",
        "mcp",
        "hook",
        "command",
        "agent",
        "plugin",
        "setting",
        "cli"
      ],
      "type": "string"
    },
    "DoctorCheck": {
      "additionalProperties": true,
      "description": "One thing `doctor` looked at.",
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SetupState"
        }
      },
      "required": [
        "detail",
        "name",
        "state"
      ],
      "title": "DoctorCheck",
      "type": "object"
    },
    "DoctorReport": {
      "additionalProperties": true,
      "description": "What `doctor` found.\n\nA report, not a verdict. `state` is the worst state among the checks, so a\ncaller that reads one field still gets the truth.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/DoctorCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/SetupState"
        }
      },
      "required": [
        "checks",
        "schema_version",
        "state"
      ],
      "title": "DoctorReport",
      "type": "object"
    },
    "HarnessId": {
      "enum": [
        "claude-code",
        "codex",
        "pi",
        "opencode",
        "grok-build",
        "cursor",
        "antigravity"
      ],
      "type": "string"
    },
    "ParameterType": {
      "enum": [
        "string",
        "boolean",
        "integer"
      ],
      "type": "string"
    },
    "SetupState": {
      "enum": [
        "ready",
        "needs_user_action",
        "partial",
        "failed"
      ],
      "type": "string"
    },
    "SyncPendingVersion": {
      "additionalProperties": false,
      "description": "An exact legacy version reference whose snapshot is not available yet.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "passport_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Passport Digest",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "stable_id": {
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "stable_id",
        "version",
        "passport_digest",
        "revision_id",
        "event_id"
      ],
      "title": "SyncPendingVersion",
      "type": "object"
    },
    "SyncPullView": {
      "additionalProperties": false,
      "description": "One atomically applied page from the private account stream.",
      "properties": {
        "applied": {
          "minimum": 0,
          "title": "Applied",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "pending_version_count": {
          "default": 0,
          "minimum": 0,
          "title": "Pending Version Count",
          "type": "integer"
        },
        "pending_versions": {
          "items": {
            "$ref": "#/$defs/SyncPendingVersion"
          },
          "maxItems": 128,
          "title": "Pending Versions",
          "type": "array"
        },
        "received": {
          "minimum": 0,
          "title": "Received",
          "type": "integer"
        },
        "replayed": {
          "minimum": 0,
          "title": "Replayed",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skipped": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Skipped",
          "type": "array"
        },
        "state": {
          "default": "pulling",
          "enum": [
            "pulling",
            "up_to_date",
            "partial"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "received",
        "applied",
        "replayed",
        "next_cursor"
      ],
      "title": "SyncPullView",
      "type": "object"
    },
    "SyncPushView": {
      "additionalProperties": false,
      "description": "Durable outcome of pushing one exact local revision.",
      "properties": {
        "conflict_fields": {
          "items": {
            "type": "string"
          },
          "title": "Conflict Fields",
          "type": "array"
        },
        "conflicting_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conflicting Entity Id"
        },
        "event_id": {
          "minLength": 8,
          "title": "Event Id",
          "type": "string"
        },
        "local_revision_id": {
          "minLength": 1,
          "title": "Local Revision Id",
          "type": "string"
        },
        "processed_events": {
          "minimum": 1,
          "title": "Processed Events",
          "type": "integer"
        },
        "remote_revision_id": {
          "minLength": 1,
          "title": "Remote Revision Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "server_head_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Server Head Revision Id"
        },
        "stable_id": {
          "minLength": 1,
          "title": "Stable Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "accepted",
            "rejected",
            "conflict",
            "superseded"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "stable_id",
        "processed_events",
        "local_revision_id",
        "event_id",
        "remote_revision_id",
        "state",
        "server_head_revision_id",
        "conflicting_entity_id"
      ],
      "title": "SyncPushView",
      "type": "object"
    },
    "TaskAccountOutcome": {
      "additionalProperties": true,
      "description": "Account drained in-process. Login never uploads; sync is a separate explicit step.",
      "properties": {
        "action": {
          "enum": [
            "login",
            "logout",
            "sync"
          ],
          "title": "Action",
          "type": "string"
        },
        "authenticated": {
          "title": "Authenticated",
          "type": "boolean"
        },
        "kind": {
          "const": "account",
          "default": "account",
          "title": "Kind",
          "type": "string"
        },
        "login_uploaded": {
          "const": false,
          "default": false,
          "title": "Login Uploaded",
          "type": "boolean"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "session_state": {
          "default": "",
          "title": "Session State",
          "type": "string"
        },
        "sync_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyncPushView"
            },
            {
              "$ref": "#/$defs/SyncPullView"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sync Result"
        },
        "synced": {
          "default": false,
          "title": "Synced",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "authenticated",
        "kind",
        "login_uploaded",
        "provider",
        "scope",
        "session_state",
        "sync_result",
        "synced"
      ],
      "title": "TaskAccountOutcome",
      "type": "object"
    },
    "TaskActor": {
      "enum": [
        "human",
        "external"
      ],
      "type": "string"
    },
    "TaskAuthorOutcome": {
      "additionalProperties": true,
      "description": "Author drained in-process. A local component and one new setup identity.",
      "properties": {
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "component_type": {
          "$ref": "#/$defs/ComponentType"
        },
        "component_version": {
          "title": "Component Version",
          "type": "string"
        },
        "directory": {
          "title": "Directory",
          "type": "string"
        },
        "harness_id": {
          "$ref": "#/$defs/HarnessId"
        },
        "kind": {
          "const": "author",
          "default": "author",
          "title": "Kind",
          "type": "string"
        },
        "minted": {
          "title": "Minted",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "setup_id": {
          "title": "Setup Id",
          "type": "string"
        },
        "setup_version": {
          "title": "Setup Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "component_type",
        "component_version",
        "directory",
        "harness_id",
        "kind",
        "minted",
        "name",
        "setup_id",
        "setup_version"
      ],
      "title": "TaskAuthorOutcome",
      "type": "object"
    },
    "TaskChangeOutcome": {
      "additionalProperties": true,
      "description": "Change drained in-process. A new setup identity; the source id is untouched.",
      "properties": {
        "harness_id": {
          "$ref": "#/$defs/HarnessId"
        },
        "kind": {
          "const": "change",
          "default": "change",
          "title": "Kind",
          "type": "string"
        },
        "minted": {
          "title": "Minted",
          "type": "boolean"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "setup_id": {
          "title": "Setup Id",
          "type": "string"
        },
        "setup_version": {
          "title": "Setup Version",
          "type": "string"
        },
        "source_setup_id": {
          "title": "Source Setup Id",
          "type": "string"
        },
        "source_setup_version": {
          "title": "Source Setup Version",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "harness_id",
        "kind",
        "minted",
        "operation_id",
        "setup_id",
        "setup_version",
        "source_setup_id",
        "source_setup_version",
        "state",
        "verified"
      ],
      "title": "TaskChangeOutcome",
      "type": "object"
    },
    "TaskId": {
      "pattern": "^task_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "TaskInitializeOutcome": {
      "additionalProperties": true,
      "description": "Initialize drained in-process. The provider writes harness files.",
      "properties": {
        "harness_id": {
          "$ref": "#/$defs/HarnessId"
        },
        "kind": {
          "const": "initialize",
          "default": "initialize",
          "title": "Kind",
          "type": "string"
        },
        "limitation": {
          "default": "",
          "title": "Limitation",
          "type": "string"
        },
        "section_digest": {
          "default": "",
          "pattern": "^(?:sha256:[0-9a-f]{64})?$",
          "title": "Section Digest",
          "type": "string"
        },
        "surface": {
          "default": "",
          "title": "Surface",
          "type": "string"
        },
        "wrote": {
          "title": "Wrote",
          "type": "boolean"
        }
      },
      "required": [
        "harness_id",
        "kind",
        "limitation",
        "section_digest",
        "surface",
        "wrote"
      ],
      "title": "TaskInitializeOutcome",
      "type": "object"
    },
    "TaskInspectOutcome": {
      "additionalProperties": true,
      "description": "Inspection drained in-process by the inspect intent.",
      "properties": {
        "doctor": {
          "$ref": "#/$defs/DoctorReport"
        },
        "kind": {
          "const": "inspect",
          "default": "inspect",
          "title": "Kind",
          "type": "string"
        },
        "orientation": {
          "$ref": "#/$defs/TaskOrientation"
        }
      },
      "required": [
        "doctor",
        "kind",
        "orientation"
      ],
      "title": "TaskInspectOutcome",
      "type": "object"
    },
    "TaskInstallOutcome": {
      "additionalProperties": true,
      "description": "Install drained in-process. Plan, approve, and apply never return to the model.",
      "properties": {
        "harness_id": {
          "$ref": "#/$defs/HarnessId"
        },
        "kind": {
          "const": "install",
          "default": "install",
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "setup_id": {
          "title": "Setup Id",
          "type": "string"
        },
        "setup_version": {
          "title": "Setup Version",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "harness_id",
        "kind",
        "operation_id",
        "setup_id",
        "setup_version",
        "state",
        "verified"
      ],
      "title": "TaskInstallOutcome",
      "type": "object"
    },
    "TaskIntent": {
      "enum": [
        "inspect",
        "initialize",
        "install",
        "change",
        "author",
        "switch",
        "account",
        "publish"
      ],
      "type": "string"
    },
    "TaskOrientation": {
      "additionalProperties": true,
      "description": "Slim inspect facts. No command registry dump.",
      "properties": {
        "catalog_enabled": {
          "title": "Catalog Enabled",
          "type": "boolean"
        },
        "cli_version": {
          "minLength": 1,
          "title": "Cli Version",
          "type": "string"
        },
        "installation": {
          "enum": [
            "distribution",
            "source"
          ],
          "title": "Installation",
          "type": "string"
        },
        "intents": {
          "items": {
            "type": "string"
          },
          "title": "Intents",
          "type": "array"
        },
        "local_schema_version": {
          "minimum": 1,
          "title": "Local Schema Version",
          "type": "integer"
        },
        "registry_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Registry Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "supported_harnesses": {
          "items": {
            "$ref": "#/$defs/HarnessId"
          },
          "minItems": 1,
          "title": "Supported Harnesses",
          "type": "array"
        },
        "sync_enabled": {
          "title": "Sync Enabled",
          "type": "boolean"
        },
        "wire_schema_version": {
          "const": 1,
          "default": 1,
          "title": "Wire Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "catalog_enabled",
        "cli_version",
        "installation",
        "intents",
        "local_schema_version",
        "registry_digest",
        "schema_version",
        "supported_harnesses",
        "sync_enabled",
        "wire_schema_version"
      ],
      "title": "TaskOrientation",
      "type": "object"
    },
    "TaskOutcome": {
      "discriminator": {
        "mapping": {
          "account": "#/$defs/TaskAccountOutcome",
          "author": "#/$defs/TaskAuthorOutcome",
          "change": "#/$defs/TaskChangeOutcome",
          "initialize": "#/$defs/TaskInitializeOutcome",
          "inspect": "#/$defs/TaskInspectOutcome",
          "install": "#/$defs/TaskInstallOutcome",
          "publish": "#/$defs/TaskPublishOutcome",
          "switch": "#/$defs/TaskSwitchOutcome"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TaskInspectOutcome"
        },
        {
          "$ref": "#/$defs/TaskInitializeOutcome"
        },
        {
          "$ref": "#/$defs/TaskInstallOutcome"
        },
        {
          "$ref": "#/$defs/TaskChangeOutcome"
        },
        {
          "$ref": "#/$defs/TaskAuthorOutcome"
        },
        {
          "$ref": "#/$defs/TaskSwitchOutcome"
        },
        {
          "$ref": "#/$defs/TaskAccountOutcome"
        },
        {
          "$ref": "#/$defs/TaskPublishOutcome"
        }
      ]
    },
    "TaskPublishOutcome": {
      "additionalProperties": true,
      "description": "Publish drained in-process. Worker receipt is not a readable catalog result.",
      "properties": {
        "kind": {
          "const": "publish",
          "default": "publish",
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "title": "Object Version",
          "type": "string"
        },
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "provenance": {
          "const": "filesystem",
          "default": "filesystem",
          "title": "Provenance",
          "type": "string"
        },
        "readable": {
          "title": "Readable",
          "type": "boolean"
        },
        "source_binding_id": {
          "default": "",
          "title": "Source Binding Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "private",
            "public"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_id",
        "object_version",
        "plan_hash",
        "plan_id",
        "provenance",
        "readable",
        "source_binding_id",
        "state",
        "visibility"
      ],
      "title": "TaskPublishOutcome",
      "type": "object"
    },
    "TaskQuestion": {
      "additionalProperties": true,
      "description": "One typed question the task engine still needs before it can continue.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/TaskActor",
          "default": "human"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "question_id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Question Id",
          "type": "string"
        },
        "recommended": {
          "default": "",
          "title": "Recommended",
          "type": "string"
        },
        "value_type": {
          "$ref": "#/$defs/ParameterType"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "choices",
        "prompt",
        "question_id",
        "recommended",
        "value_type",
        "why"
      ],
      "title": "TaskQuestion",
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "planned",
        "blocked",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "TaskSwitchOutcome": {
      "additionalProperties": true,
      "description": "Switch drained in-process. Restores last user working config; never kills the caller.",
      "properties": {
        "drift_preserved_setup_id": {
          "default": "",
          "title": "Drift Preserved Setup Id",
          "type": "string"
        },
        "harness_id": {
          "$ref": "#/$defs/HarnessId"
        },
        "kind": {
          "const": "switch",
          "default": "switch",
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "preserved_setup_id": {
          "title": "Preserved Setup Id",
          "type": "string"
        },
        "process_killed": {
          "const": false,
          "default": false,
          "title": "Process Killed",
          "type": "boolean"
        },
        "project_root": {
          "title": "Project Root",
          "type": "string"
        },
        "session_loaded": {
          "const": false,
          "default": false,
          "title": "Session Loaded",
          "type": "boolean"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "drift_preserved_setup_id",
        "harness_id",
        "kind",
        "operation_id",
        "preserved_setup_id",
        "process_killed",
        "project_root",
        "session_loaded",
        "state",
        "verified"
      ],
      "title": "TaskSwitchOutcome",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-task",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One durable agent task. Envelope `ok` is independent of `state`.",
  "properties": {
    "child_operation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Child Operation Ids",
      "type": "array"
    },
    "goal_satisfied": {
      "title": "Goal Satisfied",
      "type": "boolean"
    },
    "intent": {
      "$ref": "#/$defs/TaskIntent"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/TaskQuestion"
      },
      "title": "Questions",
      "type": "array"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/TaskState"
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    }
