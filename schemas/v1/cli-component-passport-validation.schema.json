{
  "$id": "urn:ai-stp:schema:v1:cli-component-passport-validation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Whether one local component head is complete enough to publish.\n\nThis is a local structural verdict, not permission to write to the cloud.\nPublication still requires its own authenticated exact plan after the\nplatform contract exists.",
  "properties": {
    "for_publication": {
      "const": true,
      "default": true,
      "title": "For Publication",
      "type": "boolean"
    },
    "invalid_fields": {
      "items": {
        "type": "string"
      },
      "title": "Invalid Fields",
      "type": "array"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "revision_id": {
      "minLength": 1,
      "title": "Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stable_id": {
      "minLength": 1,
      "title": "Stable Id",
      "type": "string"
    }
  },
  "required": [
    "for_publication",
    "invalid_fields",
    "missing_fields",
    "ready",
    "revision_id",
    "schema_version",
    "stable_id"
  ],
  "title": "ComponentPassportValidation",
  "type": "object"
}
