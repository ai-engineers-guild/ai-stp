{
  "$defs": {
    "Continuation": {
      "additionalProperties": true,
      "description": "One next step with bound values, and the names still missing.\n\n``argv`` is the execution form. ``continuation_command`` is a quoted display\nstring and is never eval input. ``next_actions`` remains that display string\nfor older callers.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/ContinuationActor",
          "default": "cli"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "kind": {
          "enum": [
            "retry",
            "advance",
            "inspect",
            "blocked",
            "terminal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Path",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "Continuation",
      "type": "object"
    },
    "ContinuationActor": {
      "enum": [
        "human",
        "agent",
        "cli",
        "external"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "OperationId": {
      "pattern": "^operation_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "RequestId": {
      "pattern": "^request_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-envelope-success",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The single JSON object of a fully successful machine invocation.",
  "properties": {
    "continuations": {
      "items": {
        "$ref": "#/$defs/Continuation"
      },
      "title": "Continuations",
      "type": "array"
    },
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Data",
      "type": "object"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "title": "Next Actions",
      "type": "array"
    },
    "ok": {
      "const": true,
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "operation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "$ref": "#/$defs/RequestId"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "data",
    "next_actions",
    "ok",
    "operation_id",
    "request_id",
    "schema_version",
    "warnings"
  ],
  "title": "SuccessEnvelope",
  "type": "object"
}
