{
  "$defs": {
    "JsonValue": {},
    "OperationId": {
      "pattern": "^operation_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "RequestId": {
      "pattern": "^request_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-envelope-success",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The single JSON object of a fully successful machine invocation.",
  "properties": {
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Data",
      "type": "object"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "title": "Next Actions",
      "type": "array"
    },
    "ok": {
      "const": true,
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "operation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "$ref": "#/$defs/RequestId"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "data",
    "next_actions",
    "ok",
    "operation_id",
    "request_id",
    "schema_version",
    "warnings"
  ],
  "title": "SuccessEnvelope",
  "type": "object"
}
