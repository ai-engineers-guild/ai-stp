{
  "$id": "urn:ai-stp:schema:v1:corporate-project-view",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "organization_id": {
      "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Organization Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "active",
        "archived"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "name",
    "organization_id",
    "project_id",
    "revision",
    "schema_version",
    "state"
  ],
  "title": "CorporateProjectView",
  "type": "object"
}
