{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-repository-bind-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "title": "Authorization Revision"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "plan_digest": {
      "maxLength": 71,
      "minLength": 71,
      "title": "Plan Digest",
      "type": "string"
    },
    "plan_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "plan_key",
    "plan_digest",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateRepositoryBindRequest",
  "type": "object"
}
