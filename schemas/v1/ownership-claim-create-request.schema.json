{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:ownership-claim-create-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "POST /v1/ownership-claims body.",
  "properties": {
    "evidence": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Evidence",
      "type": "string"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stable_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Stable Id",
      "type": "string"
    }
  },
  "required": [
    "stable_id",
    "reason",
    "evidence",
    "idempotency_key"
  ],
  "title": "OwnershipClaimCreateRequest",
  "type": "object"
}
