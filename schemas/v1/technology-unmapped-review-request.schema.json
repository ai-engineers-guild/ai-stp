{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:technology-unmapped-review-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Propose or clear the candidate technology for one unmapped coordinate.",
  "properties": {
    "authorization_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^corporate:organization_[A-Za-z0-9_-]+:[1-9][0-9]*:[1-9][0-9]*$",
          "type": "string"
        }
      ],
      "title": "Authorization Revision"
    },
    "candidate_technology_id": {
      "anyOf": [
        {
          "pattern": "^technology_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Technology Id"
    },
    "coordinate": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/@+*-]+$",
      "title": "Coordinate",
      "type": "string"
    },
    "expected_revision": {
      "default": 0,
      "maximum": 0,
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "kind": {
      "enum": [
        "package",
        "image",
        "executable",
        "configuration",
        "alias"
      ],
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "authorization_revision",
    "idempotency_key",
    "kind",
    "coordinate",
    "candidate_technology_id"
  ],
  "title": "TechnologyUnmappedReviewRequest",
  "type": "object"
}
