{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-membership-assignment-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Account Id",
      "type": "string"
    },
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "operation": {
      "default": "assign",
      "enum": [
        "assign",
        "remove"
      ],
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "team_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "team_role": {
      "default": "staff",
      "enum": [
        "lead",
        "staff"
      ],
      "title": "Team Role",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "authorization_revision",
    "idempotency_key"
  ],
  "title": "CorporateMembershipAssignmentRequest",
  "type": "object"
}
