{
  "$defs": {
    "RecordedVersion": {
      "additionalProperties": true,
      "description": "One immutable `X.Y` version (`SPEC-005` REQ-503, REQ-504).\n\nThe number and the digest travel together because that pairing is the whole\nguarantee: one number stands for one hash, and an exact reference means\nsomething only while that holds.",
      "properties": {
        "created_at": {
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "passport_digest": {
          "minLength": 1,
          "title": "Passport Digest",
          "type": "string"
        },
        "revision_id": {
          "minLength": 1,
          "title": "Revision Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "passport_digest",
        "revision_id",
        "schema_version",
        "version"
      ],
      "title": "RecordedVersion",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-version-line",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Every recorded version of one object, and what comes next.\n\n`next_minor` is computed from what is stored rather than remembered, so two\nmachines with the same history propose the same number. There is no\n`next_major`: `REQ-507` makes that a decision, and a field offering it would\nread as a suggestion to take it.",
  "properties": {
    "forked_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forked From"
    },
    "forked_from_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forked From Version"
    },
    "next_minor": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Next Minor",
      "type": "string"
    },
    "publish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publish Reason"
    },
    "publishable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publishable"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stable_id": {
      "minLength": 1,
      "title": "Stable Id",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/RecordedVersion"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "forked_from",
    "forked_from_version",
    "next_minor",
    "publish_reason",
    "publishable",
    "schema_version",
    "stable_id",
    "versions"
  ],
  "title": "VersionLine",
  "type": "object"
}
