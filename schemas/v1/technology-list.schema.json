{
  "$defs": {
    "TechnologyView": {
      "additionalProperties": true,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Aliases",
          "type": "array"
        },
        "category_ids": {
          "items": {
            "pattern": "^category_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Category Ids",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "icon_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon Url"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "active",
            "deprecated",
            "archived"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "official_urls": {
          "default": [],
          "items": {
            "maxLength": 2048,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Official Urls",
          "type": "array"
        },
        "organization_id": {
          "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Organization Id",
          "type": "string"
        },
        "provenance": {
          "maxLength": 256,
          "title": "Provenance",
          "type": "string"
        },
        "redirect_id": {
          "anyOf": [
            {
              "pattern": "^technology_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redirect Id"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "technology_id": {
          "pattern": "^technology_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Technology Id",
          "type": "string"
        }
      },
      "required": [
        "aliases",
        "category_ids",
        "description",
        "icon_url",
        "lifecycle",
        "name",
        "official_urls",
        "organization_id",
        "provenance",
        "redirect_id",
        "revision",
        "schema_version",
        "technology_id"
      ],
      "title": "TechnologyView",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:technology-list",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TechnologyView"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total"
  ],
  "title": "TechnologyList",
  "type": "object"
}
