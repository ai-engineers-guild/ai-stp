        "capabilities",
        "component_kind",
        "component_stable_id",
        "component_version",
        "device_id",
        "event_id",
        "harness",
        "harness_version",
        "health",
        "kind",
        "last_sync_at",
        "occurred_at",
        "organization_id",
        "outcome",
        "project_id",
        "provider_name",
        "provider_version",
        "received_at",
        "schema_version",
        "setup_id",
        "subject_state"
