      "title": "Items",
      "type": "array"
    },
    "organization_id": {
      "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Organization Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "exported_at",
    "items",
    "organization_id",
    "schema_version"
  ],
  "title": "CorporateTelemetryExport",
  "type": "object"
