      "title": "CorporateJobTitleView",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-job-title-list",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "items": {
