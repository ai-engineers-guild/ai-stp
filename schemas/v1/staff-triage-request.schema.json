{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:staff-triage-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "POST /v1/staff/reports/{case_id}/triage body.",
  "properties": {
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "triaged",
        "awaiting_author",
        "security_escalated",
        "resolved",
        "dismissed"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "state",
    "reason",
    "idempotency_key"
  ],
  "title": "StaffTriageRequest",
  "type": "object"
}
