{
  "$defs": {
    "ComponentEvalPlan": {
      "additionalProperties": false,
      "description": "Content-addressed evaluation plan bound to every adaptation of one version.",
      "properties": {
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/EvalComponentCoordinate"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "harness_version": {
          "minLength": 1,
          "title": "Harness Version",
          "type": "string"
        },
        "passport_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Passport Digest",
          "type": "string"
        },
        "plan_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Digest",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^eval_plan_[0-9a-f]{24}$",
          "title": "Plan Id",
          "type": "string"
        },
        "planned_at": {
          "minLength": 1,
          "title": "Planned At",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/SetupEvalProfile"
        },
        "provider_version": {
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "runner_version": {
          "minLength": 1,
          "title": "Runner Version",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stable_id": {
          "minLength": 1,
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "plan_digest",
        "profile",
        "stable_id",
        "version",
        "passport_digest",
        "artifact_digest",
        "harness_version",
        "provider_version",
        "runner_version",
        "components",
        "planned_at"
      ],
      "title": "ComponentEvalPlan",
      "type": "object"
    },
    "ComponentType": {
      "enum": [
        "instruction",
        "skill",
        "mcp",
        "hook",
        "command",
        "agent",
        "plugin",
        "setting",
        "cli"
      ],
      "type": "string"
    },
    "EvalComponentCoordinate": {
      "additionalProperties": false,
      "description": "Exact component identity inside the evaluated setup graph.",
      "properties": {
        "adaptation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptation Id"
        },
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "component_type": {
          "$ref": "#/$defs/ComponentType"
        },
        "harness_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness Id"
        },
        "passport_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Passport Digest",
          "type": "string"
        },
        "projection_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Digest"
        },
        "stable_id": {
          "minLength": 1,
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "stable_id",
        "version",
        "passport_digest",
        "artifact_digest",
        "component_type"
      ],
      "title": "EvalComponentCoordinate",
      "type": "object"
    },
    "EvaluationBudget": {
      "additionalProperties": false,
      "description": "Closed resource ceiling for one evaluation check.",
      "properties": {
        "max_network_requests": {
          "default": 0,
          "maximum": 1024,
          "minimum": 0,
          "title": "Max Network Requests",
          "type": "integer"
        },
        "max_output_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "timeout_seconds",
        "max_output_bytes"
      ],
      "title": "EvaluationBudget",
      "type": "object"
    },
    "EvaluationCheck": {
      "additionalProperties": false,
      "description": "One declared assertion and the runner class allowed to evaluate it.",
      "properties": {
        "assertion": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Assertion",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/EvaluationBudget"
        },
        "check_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,95}$",
          "title": "Check Id",
          "type": "string"
        },
        "component_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "isolation_requirements": {
          "default": [],
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "title": "Isolation Requirements",
          "type": "array"
        },
        "method": {
          "enum": [
            "deterministic",
            "model_assisted",
            "human_review"
          ],
          "title": "Method",
          "type": "string"
        },
        "runner": {
          "enum": [
            "local_static",
            "isolated_process",
            "model",
            "human"
          ],
          "title": "Runner",
          "type": "string"
        },
        "tolerance": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Tolerance",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "method",
        "runner",
        "assertion",
        "tolerance",
        "budget"
      ],
      "title": "EvaluationCheck",
      "type": "object"
    },
    "EvaluationCheckResult": {
      "additionalProperties": false,
      "description": "Observed result of one check without promotion of unavailable runners.",
      "properties": {
        "adaptation_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adaptation Ids",
          "type": "array"
        },
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "component_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Component Ids",
          "type": "array"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "method": {
          "enum": [
            "deterministic",
            "model_assisted",
            "human_review"
          ],
          "title": "Method",
          "type": "string"
        },
        "runner": {
          "minLength": 1,
          "title": "Runner",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "method",
        "runner",
        "status",
        "message"
      ],
      "title": "EvaluationCheckResult",
      "type": "object"
    },
    "PermissionClaim": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f]+$",
      "type": "string"
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "Declared file, network and process permissions.",
      "properties": {
        "filesystem": {
          "items": {
            "$ref": "#/$defs/PermissionClaim"
          },
          "title": "Filesystem",
          "type": "array",
          "uniqueItems": true
        },
        "network": {
          "items": {
            "$ref": "#/$defs/PermissionClaim"
          },
          "title": "Network",
          "type": "array",
          "uniqueItems": true
        },
        "process": {
          "items": {
            "$ref": "#/$defs/PermissionClaim"
          },
          "title": "Process",
          "type": "array",
          "uniqueItems": true
        }
      },
      "title": "Permissions",
      "type": "object"
    },
    "SetupEvalProfile": {
      "additionalProperties": false,
      "description": "Reusable evaluation intent, independent from one setup version.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/EvaluationCheck"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "component_types": {
          "items": {
            "$ref": "#/$defs/ComponentType"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Component Types",
          "type": "array"
        },
        "eval_permissions": {
          "$ref": "#/$defs/Permissions"
        },
        "preconditions": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "profile_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,95}$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "const": "setup-eval/1",
          "default": "setup-eval/1",
          "title": "Profile Version",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "enum": [
            "component",
            "subset",
            "setup"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "scope",
        "component_types",
        "preconditions",
        "checks",
        "eval_permissions"
      ],
      "title": "SetupEvalProfile",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:cli-component-eval-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable local evaluation evidence for every advertised adaptation.",
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/EvaluationCheckResult"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "executed_at": {
      "minLength": 1,
      "title": "Executed At",
      "type": "string"
    },
    "immutable_published_bytes_changed": {
      "const": false,
      "default": false,
      "title": "Immutable Published Bytes Changed",
      "type": "boolean"
    },
    "plan": {
      "$ref": "#/$defs/ComponentEvalPlan"
    },
    "provider_permissions_used": {
      "const": false,
      "default": false,
      "title": "Provider Permissions Used",
      "type": "boolean"
    },
    "result_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Result Digest",
      "type": "string"
    },
    "run_id": {
      "pattern": "^eval_run_[0-9a-f]{24}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "not_run",
        "degraded"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "result_digest",
    "plan",
    "status",
    "executed_at",
    "checks"
  ],
  "title": "ComponentEvalResult",
  "type": "object"
}
