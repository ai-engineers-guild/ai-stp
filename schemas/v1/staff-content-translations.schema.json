{
  "$defs": {
    "ContentBody": {
      "maxLength": 200000,
      "minLength": 1,
      "type": "string"
    },
    "ContentDate": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "ContentDescription": {
      "maxLength": 320,
      "minLength": 1,
      "type": "string"
    },
    "ContentImage": {
      "maxLength": 512,
      "pattern": "^/content/illustrations/[a-z0-9._-]+\\.(?:svg|png|jpg|jpeg|webp|gif)$",
      "type": "string"
    },
    "ContentImageAlt": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "ContentTag": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
    },
    "ContentTitle": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "StaffContentTranslation": {
      "additionalProperties": false,
      "description": "One locale of a staff publication payload.",
      "properties": {
        "body": {
          "$ref": "#/$defs/ContentBody"
        },
        "cover_alt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentImageAlt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cover_image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "$ref": "#/$defs/ContentDescription"
        },
        "published_at": {
          "$ref": "#/$defs/ContentDate"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/ContentTag"
          },
          "maxItems": 12,
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/ContentTitle"
        }
      },
      "required": [
        "title",
        "description",
        "published_at",
        "tags",
        "body"
      ],
      "title": "StaffContentTranslation",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:staff-content-translations",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact RU/EN pair. Any other locale set is unrepresentable.",
  "properties": {
    "en": {
      "$ref": "#/$defs/StaffContentTranslation"
    },
    "ru": {
      "$ref": "#/$defs/StaffContentTranslation"
    }
  },
  "required": [
    "ru",
    "en"
  ],
  "title": "StaffContentTranslations",
  "type": "object"
}
