{
  "$defs": {
    "CorporateEffectivePermission": {
      "additionalProperties": true,
      "properties": {
        "permission": {
          "title": "Permission",
          "type": "string"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "scope_kind": {
          "enum": [
            "organization",
            "team",
            "project",
            "technology",
            "catalog_object",
            "member"
          ],
          "title": "Scope Kind",
          "type": "string"
        },
        "source_records": {
          "items": {
            "$ref": "#/$defs/CorporatePermissionSource"
          },
          "title": "Source Records",
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "permission",
        "scope_id",
        "scope_kind",
        "source_records",
        "sources"
      ],
      "title": "CorporateEffectivePermission",
      "type": "object"
    },
    "CorporatePermissionDefinition": {
      "additionalProperties": true,
      "description": "One action the server actually checks, with the scopes it honors.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "create_parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Create Parent"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "implementation": {
          "const": "enforced",
          "default": "enforced",
          "title": "Implementation",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "scopes": {
          "items": {
            "enum": [
              "organization",
              "team",
              "project",
              "technology",
              "catalog_object",
              "member"
            ],
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "action",
        "create_parent",
        "group",
        "implementation",
        "name",
        "resource",
        "scopes"
      ],
      "title": "CorporatePermissionDefinition",
      "type": "object"
    },
    "CorporatePermissionSource": {
      "additionalProperties": true,
      "description": "One record that actually contributes a permission at this scope.",
      "properties": {
        "kind": {
          "enum": [
            "binding",
            "grant"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "scope_kind": {
          "title": "Scope Kind",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "origin",
        "role",
        "scope_id",
        "scope_kind",
        "source_id"
      ],
      "title": "CorporatePermissionSource",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:corporate-permission-matrix",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authorization_revision": {
      "minimum": 1,
      "title": "Authorization Revision",
      "type": "integer"
    },
    "definitions": {
      "items": {
        "$ref": "#/$defs/CorporatePermissionDefinition"
      },
      "title": "Definitions",
      "type": "array"
    },
    "effective": {
      "items": {
        "$ref": "#/$defs/CorporateEffectivePermission"
      },
      "title": "Effective",
      "type": "array"
    },
    "organization_id": {
      "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Organization Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "authorization_revision",
    "definitions",
    "effective",
    "organization_id",
    "schema_version"
  ],
  "title": "CorporatePermissionMatrix",
  "type": "object"
}
