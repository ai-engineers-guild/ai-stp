{
  "$defs": {
    "TechnologyMergeProjectEffect": {
      "additionalProperties": true,
      "properties": {
        "project_id": {
          "pattern": "^remote_project_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Project Id",
          "type": "string"
        },
        "source_relation_id": {
          "pattern": "^relation_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Source Relation Id",
          "type": "string"
        },
        "target_action": {
          "enum": [
            "create",
            "update"
          ],
          "title": "Target Action",
          "type": "string"
        },
        "target_relation_id": {
          "pattern": "^relation_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Target Relation Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "source_relation_id",
        "target_action",
        "target_relation_id"
      ],
      "title": "TechnologyMergeProjectEffect",
      "type": "object"
    },
    "TechnologyMergeTeamEffect": {
      "additionalProperties": true,
      "properties": {
        "source_relation_id": {
          "pattern": "^relation_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Source Relation Id",
          "type": "string"
        },
        "target_action": {
          "enum": [
            "create",
            "update"
          ],
          "title": "Target Action",
          "type": "string"
        },
        "target_relation_id": {
          "pattern": "^relation_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Target Relation Id",
          "type": "string"
        },
        "team_id": {
          "pattern": "^operation_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "source_relation_id",
        "target_action",
        "target_relation_id",
        "team_id"
      ],
      "title": "TechnologyMergeTeamEffect",
      "type": "object"
    },
    "TechnologyView": {
      "additionalProperties": true,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Aliases",
          "type": "array"
        },
        "category_ids": {
          "items": {
            "pattern": "^category_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Category Ids",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "icon_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon Url"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "active",
            "deprecated",
            "archived"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "official_urls": {
          "default": [],
          "items": {
            "maxLength": 2048,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Official Urls",
          "type": "array"
        },
        "organization_id": {
          "pattern": "^organization_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Organization Id",
          "type": "string"
        },
        "owner_account_id": {
          "anyOf": [
            {
              "pattern": "^account_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Account Id"
        },
        "provenance": {
          "maxLength": 256,
          "title": "Provenance",
          "type": "string"
        },
        "redirect_id": {
          "anyOf": [
            {
              "pattern": "^technology_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redirect Id"
        },
        "restore_lifecycle": {
          "default": "draft",
          "enum": [
            "draft",
            "active",
            "deprecated"
          ],
          "title": "Restore Lifecycle",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "technology_id": {
          "pattern": "^technology_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Technology Id",
          "type": "string"
        }
      },
      "required": [
        "aliases",
        "category_ids",
        "description",
        "icon_url",
        "lifecycle",
        "name",
        "official_urls",
        "organization_id",
        "owner_account_id",
        "provenance",
        "redirect_id",
        "restore_lifecycle",
        "revision",
        "schema_version",
        "technology_id"
      ],
      "title": "TechnologyView",
      "type": "object"
    }
  },
  "$id": "urn:ai-stp:schema:v1:technology-merge-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "project_effects": {
      "items": {
        "$ref": "#/$defs/TechnologyMergeProjectEffect"
      },
      "title": "Project Effects",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/TechnologyView"
    },
    "target": {
      "$ref": "#/$defs/TechnologyView"
    },
    "team_effects": {
      "items": {
        "$ref": "#/$defs/TechnologyMergeTeamEffect"
      },
      "title": "Team Effects",
      "type": "array"
    }
  },
  "required": [
    "project_effects",
    "source",
    "target",
    "team_effects"
  ],
  "title": "TechnologyMergeResult",
  "type": "object"
}
