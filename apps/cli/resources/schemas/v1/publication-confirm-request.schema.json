{
  "$defs": {
    "IdempotencyKey": {
      "pattern": "^[A-Za-z0-9._~-]{16,128}$",
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:publication-confirm-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "POST /v1/publications/plans/{plan_id}/confirm body.",
  "properties": {
    "confirmed": {
      "const": true,
      "default": true,
      "title": "Confirmed",
      "type": "boolean"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "plan_hash": {
      "maxLength": 128,
      "minLength": 16,
      "title": "Plan Hash",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "plan_hash",
    "idempotency_key"
  ],
  "title": "PublicationConfirmRequest",
  "type": "object"
}
