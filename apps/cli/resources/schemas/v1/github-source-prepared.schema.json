{
  "$defs": {
    "ContentDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "PlanId": {
      "maxLength": 64,
      "minLength": 8,
      "type": "string"
    }
  },
  "$id": "urn:ai-stp:schema:v1:github-source-prepared",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Opaque provenance and inventory; no private repository coordinate.",
  "properties": {
    "artifact_inventory": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Artifact Inventory",
      "type": "array"
    },
    "content_digest": {
      "$ref": "#/$defs/ContentDigest"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_binding_id": {
      "$ref": "#/$defs/PlanId"
    },
    "source_visibility": {
      "enum": [
        "private",
        "public"
      ],
      "title": "Source Visibility",
      "type": "string"
    }
  },
  "required": [
    "artifact_inventory",
    "content_digest",
    "size_bytes",
    "source_binding_id",
    "source_visibility"
  ],
  "title": "GitHubSourcePrepared",
  "type": "object"
}
