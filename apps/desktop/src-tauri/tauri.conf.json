{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-stp-desktop",
  "version": "0.0.7",
  "identifier": "space.aiguild.ai-stp-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ai-stp-desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AI Engineers Guild",
    "copyright": "© AI Engineers Guild",
    "category": "public.app-category.developer-tools",
    "shortDescription": "Desktop companion for the ai-stp CLI",
    "homepage": "https://github.com/ai-engineers-guild/ai-stp",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "resources": {
      "sidecar/cli/": "cli/"
    }
  }
}
