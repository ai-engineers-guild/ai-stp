{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default window capabilities — IPC invoke only; no shell/fs/network scopes open to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://localhost*" },
        { "url": "http://127.0.0.1*" },
        { "url": "http://[::1]*" }
      ]
    },
    "window-state:default"
  ]
}
