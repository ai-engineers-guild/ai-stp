{
  "name": "ai-stp-desktop",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "node ./node_modules/typescript7/lib/tsc.js --noEmit -p tsconfig.json",
    "build": "bun run type-check && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "lint:dependencies": "knip",
    "format": "biome format --write src scripts *.ts *.json .oxlintrc.json src-tauri/capabilities",
    "format:check": "biome format src scripts *.ts *.json .oxlintrc.json src-tauri/capabilities",
    "messages:check": "node scripts/check-messages.mjs",
    "lint:biome": "biome lint --error-on-warnings --diagnostic-level=warn src scripts *.ts *.json .oxlintrc.json src-tauri/capabilities",
    "lint:types": "oxlint --type-aware --deny-warnings src scripts",
    "lint": "bun run lint:biome && bun run lint:types"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "i18next": "26.7.2",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.4",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-router": "8.5.1",
    "zustand": "5.0.16"
  },
  "overrides": {
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "knip": "6.44.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "typescript7": "npm:typescript@7.0.2"
  }
}
