{
  "name": "ai-stp-desktop",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "node ./node_modules/typescript7/lib/tsc.js --noEmit -p tsconfig.json",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "format": "prettier --write src scripts \"*.ts\" \"*.json\" \"src-tauri/capabilities/*.json\"",
    "format:check": "prettier --check src scripts \"*.ts\" \"*.json\" \"src-tauri/capabilities/*.json\"",
    "messages:check": "node scripts/check-messages.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "i18next": "26.7.1",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.3",
    "lucide-react": "1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "17.1.11",
    "react-router": "^8.5.0",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "typescript7": "npm:typescript@7.0.2"
  }
}
