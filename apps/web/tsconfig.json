{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-checks-preview/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "openapi-ts.config.ts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/api/generated/**",
    "src/lib/api/generated",
    "storybook-static",
    ".storybook",
    "src/stories/**"
  ]
}
