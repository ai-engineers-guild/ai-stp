{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Portable design tokens for ai_stp web. Source of truth for theme; CSS variables and Storybook foundations map from here. Safe to re-export into Open Design / Figma Tokens / Style Dictionary.",
  "color": {
    "background": {
      "light": {
        "$type": "color",
        "$value": "0 0% 100%",
        "$description": "Human canvas #ffffff. HSL channels without hsl()"
      },
      "dark": {
        "$type": "color",
        "$value": "0 0% 6%",
        "$description": "Machine canvas #101010"
      }
    },
    "foreground": {
      "light": { "$type": "color", "$value": "0 0% 9%", "$description": "Ink #181818" },
      "dark": { "$type": "color", "$value": "0 0% 100%", "$description": "White #ffffff" }
    },
    "card": {
      "light": { "$type": "color", "$value": "48 29% 97%", "$description": "Sand #f9f8f4" },
      "dark": { "$type": "color", "$value": "0 0% 9%", "$description": "Ink surface #181818" }
    },
    "card-foreground": {
      "light": { "$type": "color", "$value": "0 0% 9%" },
      "dark": { "$type": "color", "$value": "0 0% 100%" }
    },
    "popover": {
      "light": { "$type": "color", "$value": "0 0% 100%" },
      "dark": { "$type": "color", "$value": "0 0% 9%" }
    },
    "popover-foreground": {
      "light": { "$type": "color", "$value": "0 0% 9%" },
      "dark": { "$type": "color", "$value": "0 0% 100%" }
    },
    "primary": {
      "light": {
        "$type": "color",
        "$value": "19 97% 55%",
        "$description": "Brand orange #fb631b — high-signal CTA only"
      },
      "dark": { "$type": "color", "$value": "19 97% 55%" }
    },
    "primary-foreground": {
      "light": { "$type": "color", "$value": "0 0% 100%" },
      "dark": { "$type": "color", "$value": "0 0% 100%" }
    },
    "primary-hover": {
      "light": {
        "$type": "color",
        "$value": "19 89% 60%",
        "$description": "Brand orange hover #f4793f"
      },
      "dark": { "$type": "color", "$value": "19 89% 60%" }
    },
    "secondary": {
      "light": { "$type": "color", "$value": "48 20% 94%" },
      "dark": { "$type": "color", "$value": "0 0% 12%" }
    },
    "secondary-foreground": {
      "light": { "$type": "color", "$value": "0 0% 9%" },
      "dark": { "$type": "color", "$value": "0 0% 100%" }
    },
    "muted": {
      "light": { "$type": "color", "$value": "48 20% 94%" },
      "dark": { "$type": "color", "$value": "0 0% 12%" }
    },
    "muted-foreground": {
      "light": {
        "$type": "color",
        "$value": "30 2% 32%",
        "$description": "WCAG AA body grey on light"
      },
      "dark": {
        "$type": "color",
        "$value": "30 1% 62%",
        "$description": "WCAG AA body grey on dark"
      }
    },
    "accent": {
      "light": {
        "$type": "color",
        "$value": "48 20% 94%",
        "$description": "Surface hover fill — not brand wash"
      },
      "dark": { "$type": "color", "$value": "0 0% 12%" }
    },
    "accent-foreground": {
      "light": { "$type": "color", "$value": "0 0% 9%" },
      "dark": { "$type": "color", "$value": "0 0% 100%" }
    },
    "destructive": {
      "light": { "$type": "color", "$value": "1 63% 45%", "$description": "Error #db6866 family" },
      "dark": { "$type": "color", "$value": "1 63% 50%" }
    },
    "destructive-foreground": {
      "light": { "$type": "color", "$value": "0 0% 100%" },
      "dark": { "$type": "color", "$value": "0 0% 100%" }
    },
    "border": {
      "light": {
        "$type": "color",
        "$value": "45 9% 81%",
        "$description": "Light hairline #d4d2cb"
      },
      "dark": { "$type": "color", "$value": "0 0% 26%", "$description": "Grey 800 #434343" }
    },
    "input": {
      "light": { "$type": "color", "$value": "45 9% 81%" },
      "dark": { "$type": "color", "$value": "0 0% 26%" }
    },
    "ring": {
      "light": { "$type": "color", "$value": "19 97% 55%" },
      "dark": { "$type": "color", "$value": "19 97% 55%" }
    },
    "success": {
      "light": { "$type": "color", "$value": "100 54% 40%", "$description": "#63b436 family" },
      "dark": { "$type": "color", "$value": "100 54% 46%" }
    },
    "success-foreground": {
      "light": { "$type": "color", "$value": "0 0% 100%" },
      "dark": { "$type": "color", "$value": "0 0% 100%" }
    },
    "warning": {
      "light": { "$type": "color", "$value": "43 69% 45%", "$description": "#dbaa36 family" },
      "dark": { "$type": "color", "$value": "43 69% 54%" }
    },
    "warning-foreground": {
      "light": { "$type": "color", "$value": "0 0% 100%" },
      "dark": { "$type": "color", "$value": "0 0% 9%" }
    }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "0.5rem", "$description": "8px default card radius" },
    "sm": { "$type": "dimension", "$value": "0.25rem", "$description": "4px controls" },
    "md": { "$type": "dimension", "$value": "0.375rem", "$description": "6px chips" },
    "lg": { "$type": "dimension", "$value": "0.5rem", "$description": "8px cards" },
    "xl": { "$type": "dimension", "$value": "1rem", "$description": "16px large shells" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "0.5": { "$type": "dimension", "$value": "0.125rem" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "1.5": { "$type": "dimension", "$value": "0.375rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "2.5": { "$type": "dimension", "$value": "0.625rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "plexSans",
          "Arial",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Helvetica Neue",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "plexMono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Monaco",
          "Consolas",
          "Liberation Mono",
          "Courier New",
          "monospace"
        ]
      }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "1.875rem" }
    },
    "weight": {
      "normal": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold": { "$type": "fontWeight", "$value": "700" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": "1.25" },
      "snug": { "$type": "number", "$value": "1.375" },
      "normal": { "$type": "number", "$value": "1.5" },
      "relaxed": { "$type": "number", "$value": "1.625" }
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 hsl(0 0% 0% / 0.06)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 4px 6px -1px hsl(0 0% 0% / 0.1), 0 2px 4px -2px hsl(0 0% 0% / 0.08)"
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "normal": { "$type": "duration", "$value": "200ms" }
    }
  },
  "icon": {
    "size": {
      "sm": { "$type": "dimension", "$value": "1rem" },
      "md": { "$type": "dimension", "$value": "1.25rem" },
      "lg": { "$type": "dimension", "$value": "1.5rem" }
    }
  },
  "zIndex": {
    "header": { "$type": "number", "$value": "40" },
    "modal": { "$type": "number", "$value": "50" },
    "toast": { "$type": "number", "$value": "60" }
  },
  "brand": {
    "name": { "$type": "string", "$value": "ai_stp" },
    "hex": {
      "machine-canvas": { "$type": "color", "$value": "#101010" },
      "ink-surface": { "$type": "color", "$value": "#181818" },
      "white": { "$type": "color", "$value": "#ffffff" },
      "grey-600": { "$type": "color", "$value": "#858483" },
      "grey-800": { "$type": "color", "$value": "#434343" },
      "brand-orange": { "$type": "color", "$value": "#fb631b" },
      "brand-orange-hover": { "$type": "color", "$value": "#f4793f" },
      "sand": { "$type": "color", "$value": "#f9f8f4" }
    }
  }
}
