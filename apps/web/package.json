{
  "name": "@ai-stp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build && node scripts/standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "type-check": "node ./node_modules/typescript7/lib/tsc.js --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:coverage": "vitest run --coverage",
    "test:coverage:catalog": "vitest run --coverage --config vitest.catalog.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:feature-profiles": "node scripts/test-feature-profiles.mjs",
    "audit": "bun audit --audit-level=high",
    "api:generate": "openapi-ts",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build -o storybook-static --disable-telemetry",
    "check": "bun run lint && bun run type-check && bun run test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@fumadocs/local-md": "^0.3.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.14.3",
    "js-yaml": "4.3.1",
    "lucide-react": "^0.539.0",
    "next": "^15.4.5",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.14",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.54.2",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-themes": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "8.6.18",
    "tailwindcss": "^4.1.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.39.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "js-yaml": "4.3.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
