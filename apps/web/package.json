{
  "name": "@ai-stp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/standalone-assets.mjs",
    "start": "next start",
    "lint": "bun run lint:biome && bun run lint:types && eslint . --max-warnings 0",
    "i18n:check": "vitest run tests/unit/i18n-parity.test.ts",
    "type-check": "node ./node_modules/typescript7/lib/tsc.js --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run test:lint && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:coverage": "bun run test:lint && vitest run --coverage",
    "test:coverage:catalog": "vitest run --coverage --config vitest.catalog.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:feature-profiles": "node scripts/test-feature-profiles.mjs",
    "audit": "node scripts/audit.mjs",
    "api:generate": "openapi-ts && prettier --write src/lib/api/generated",
    "api:check": "node scripts/api-check.mjs",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build -o storybook-static --disable-telemetry",
    "check": "bun run lint && bun run type-check && bun run test && bun run build && bun run test:e2e",
    "lint:dependencies": "knip --dependencies --files --exports",
    "lint:biome": "biome lint --error-on-warnings --diagnostic-level=warn .",
    "lint:types": "oxlint --type-aware --deny-warnings src tests scripts",
    "test:lint": "bun scripts/test-lint-contracts.mjs"
  },
  "dependencies": {
    "@fumadocs/local-md": "0.5.0",
    "@next/third-parties": "16.4.6",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-core": "16.19.0",
    "js-yaml": "5.5.0",
    "lucide-react": "1.72.0",
    "markdown-it": "15.0.3",
    "next": "16.4.6",
    "next-intl": "4.15.0",
    "next-themes": "0.4.6",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.15",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/react": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "knip": "6.45.1",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-import-resolver-typescript": "4.4.5"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "overrides": {
    "nanoid": "3.3.20",
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "js-yaml": "5.5.0",
    "source-map-js": "1.2.2",
    "glob": "14.0.5",
    "minimatch@>=10.0.0": "11.0.3",
    "@hey-api/json-schema-ref-parser@1.4.4>js-yaml": "4.3.2"
  },
  "patchedDependencies": {
    "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
  }
}
