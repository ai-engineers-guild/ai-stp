{
  "name": "@ai-stp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "i18n:check": "vitest run tests/unit/i18n-parity.test.ts",
    "type-check": "node ./node_modules/typescript7/lib/tsc.js --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:coverage": "vitest run --coverage",
    "test:coverage:catalog": "vitest run --coverage --config vitest.catalog.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:feature-profiles": "node scripts/test-feature-profiles.mjs",
    "audit": "node scripts/audit.mjs",
    "api:generate": "openapi-ts",
    "api:check": "node scripts/api-check.mjs",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build -o storybook-static --disable-telemetry",
    "check": "bun run lint && bun run type-check && bun run test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@fumadocs/local-md": "^0.3.5",
    "@hey-api/client-fetch": "^0.13.1",
    "@hookform/resolvers": "^5.9.1",
    "@next/third-parties": "16.3.8",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.16.1",
    "js-yaml": "4.3.2",
    "lucide-react": "^1.52.0",
    "markdown-it": "15.0.2",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "read-excel-file": "9.3.10",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/react": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "overrides": {
    "nanoid": "3.3.20",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
