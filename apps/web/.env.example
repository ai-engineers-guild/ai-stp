# Public origin of the web app (used for absolute URLs and cookie scope).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public user documentation origin. Local compose publishes the docs service here.
AI_STP_USER_DOCS_URL=http://localhost:8011

# Backend API base URL. Anonymous catalog reads and authenticated calls go here.
# Point at MSW (same origin /mock) during local mock-first development, or the real API.
AI_STP_API_BASE_URL=http://localhost:8000

# When true, browser and server use MSW handlers backed by #71 fixtures.
AI_STP_USE_MOCKS=false
# When true, mock only the auth surface; false uses real OAuth via the API.
AI_STP_MOCK_AUTH=false

# Cookie signing secret for the opaque web session (ADR-0041). Minimum 32 chars.
AI_STP_SESSION_SECRET=dev-only-change-me-to-a-long-random-string
