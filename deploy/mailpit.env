# Worker mail defaults for the dev stack — the Mailpit catch-all.
# Loaded via env_file BEFORE ../.env.dev, so values in .env.dev always win:
# point SMTP_* at a real relay (company mailbox, self-hosted MTA, Gmail) or
# set MAIL_PROVIDER=resend plus a key, and mail leaves the catch-all.
AI_STP_WORKER_INVITATION_BASE_URL=http://localhost:3000/ru
AI_STP_WORKER_SMTP_HOST=mailpit
AI_STP_WORKER_SMTP_PORT=1025
AI_STP_WORKER_SMTP_USE_TLS=false
AI_STP_WORKER_SMTP_USE_STARTTLS=false
AI_STP_WORKER_CORPORATE_MAIL_FROM_ADDRESS=invitations@corp.example
