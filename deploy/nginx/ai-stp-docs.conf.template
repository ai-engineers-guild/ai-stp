# Public edge for the user-documentation host (SPEC-019 REQ-1903, ADR-0135).
# Separate from the main host template because the two names are provisioned
# independently: a docs subdomain without DNS and a certificate must not be
# installed, or nginx refuses to start over the missing lineage.

# Each upstream is a serving container and its standby. Only the first serves
# while it answers, so the stack keeps one active process. A deploy replaces the
# two one at a time, and a connection the stopped one refuses goes to the other:
# nginx retries every method then, because nothing reached the refused upstream.
upstream ai_stp_docs_@@SITE@@ {
    server @@DOCS_BIND@@ max_fails=1 fail_timeout=5s;
    server @@DOCS_STANDBY_BIND@@ backup;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@DOCS_HOST@@;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @@DOCS_HOST@@;

    ssl_certificate /etc/letsencrypt/live/@@LINEAGE@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@LINEAGE@@/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Same HSTS posture as the main host; the apex's includeSubDomains only
    # takes effect after a client has visited the apex, so the docs name
    # declares it for itself. `always` keeps it on error responses.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;

    location / {
        proxy_pass http://ai_stp_docs_@@SITE@@;
    }
}
