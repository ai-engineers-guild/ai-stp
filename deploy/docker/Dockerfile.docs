# Multi-stage image for the public user documentation site.

FROM python:3.15.2-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    NO_MKDOCS_2_WARNING=1 \
    PATH="/app/.venv/bin:${PATH}"
# Match the exact uv version used by CI.
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /bin/uv
WORKDIR /app
# Same apt discipline as the api stage in `deploy/docker/Dockerfile.app`: a dated snapshot plus an
# exact version is the only form of apt install that is reproducible from the
# commit. `git` exists here for the dev target's volume-mounted rebuilds.
RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/20260927T000000Z|g' \
      -e 's|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/20260927T000000Z|g' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends git=1:2.47.3-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY apps ./apps
RUN uv sync --locked --only-group docs --no-install-project --no-install-workspace

COPY docs_scripts/user-mkdocs.yml ./docs_scripts/user-mkdocs.yml
COPY docs_scripts/user-mkdocs.en.yml ./docs_scripts/user-mkdocs.en.yml
COPY docs_scripts/user_docs_dev.py ./docs_scripts/user_docs_dev.py
COPY docs-user-facing/docs ./docs-user-facing/docs

FROM base AS dev
ENV AI_STP_USER_DOCS_SITE_URL=http://localhost:8011/
ENV AI_STP_USER_DOCS_EN_SITE_URL=http://localhost:8011/en/
EXPOSE 8000
# Dual build then static serve: English lives at /en/, same layout as prod.
# `mkdocs serve` can host only one docs_dir, so a Russian-only live server
# 404s the language switcher.
CMD ["python", "docs_scripts/user_docs_dev.py", "--host", "0.0.0.0", "--port", "8000"]

FROM base AS build
ARG AI_STP_USER_DOCS_SITE_URL=https://docs.example.invalid/
ENV AI_STP_USER_DOCS_SITE_URL=${AI_STP_USER_DOCS_SITE_URL}
# `%/` guards a base URL given without its trailing slash; `...en/` would
# otherwise glue into the hostname (docs.example.invaliden/).
ENV AI_STP_USER_DOCS_EN_SITE_URL=${AI_STP_USER_DOCS_SITE_URL%/}/en/
# Russian first: it cleans the site directory, and the English build writes
# `en/` inside it. Reversing these two silently ships one language.
RUN python -m mkdocs build --strict -f docs_scripts/user-mkdocs.yml \
    && python -m mkdocs build --strict -f docs_scripts/user-mkdocs.en.yml

FROM nginx:1.31.8-alpine@sha256:fed7e14be83cbd2661a75cdc5b872d936cf155d46c327084d30b8df19ae88d72 AS prod
COPY deploy/nginx/user-docs-main.conf /etc/nginx/nginx.conf
COPY deploy/nginx/user-docs.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/.site-user-docs /srv
EXPOSE 8080
# The pinned nginx image already supplies UID/GID 101. All runtime writes use /tmp.
USER 101:101
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
