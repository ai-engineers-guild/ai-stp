# Reference path-split for local reverse proxy (optional).
# docker-compose.dev.yml no longer runs Caddy: web is published on :3000, user
# docs on :8011, and Next.js rewrites /v1/* (and API docs paths) to the internal
# API in development.
# Prod still uses Caddyfile.prod as the sole public edge (ADR-0044).
# Keep this file as documentation of the historical path map and for optional
# manual `caddy run` experiments.
{
	auto_https off
}

:80 {
	handle /v1/* {
		reverse_proxy api:8000
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /redoc* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

:8011 {
	reverse_proxy docs:8000
}
