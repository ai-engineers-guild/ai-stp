{
  "schema_version": 1,
  "cases": [
    {
      "case_id": "startDeviceAuthorization.google",
      "operation_id": "startDeviceAuthorization",
      "kind": "positive",
      "why": "The start request carries the provider and nothing else: before a human approves there is no account to bind a key to.",
      "request": {
        "body": {
          "schema_version": 1,
          "provider": "google",
          "idempotency_key": "0123456789abcdef0123456789abcdef"
        }
      },
      "status": 201,
      "body": {
        "schema_version": 1,
        "device_code": "FIXTUREdeviceCODE0123456789abcdefGHIJKLM",
        "user_code": "BCDF-GHJK",
        "verification_uri": "https://ai-stp.example/device",
        "verification_uri_complete": "https://ai-stp.example/device?code=BCDF-GHJK",
        "expires_in": 600,
        "interval": 5
      }
    },
    {
      "case_id": "startDeviceAuthorization.keyAtStart",
      "operation_id": "startDeviceAuthorization",
      "kind": "rejected_request",
      "why": "Accepting a device key before approval would let an unauthenticated caller park keys against pending codes.",
      "request": {
        "body": {
          "schema_version": 1,
          "provider": "google",
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
          "idempotency_key": "0123456789abcdef0123456789abcdef"
        }
      },
      "status": 400,
      "error_code": "AI_STP_VALIDATION_ERROR"
    },
    {
      "case_id": "startDeviceAuthorization.unknownProvider",
      "operation_id": "startDeviceAuthorization",
      "kind": "rejected_request",
      "why": "The provider set is closed; a third one is a schema change, not a configuration flag.",
      "request": {
        "body": {
          "schema_version": 1,
          "provider": "gitlab",
          "idempotency_key": "0123456789abcdef0123456789abcdef"
        }
      },
      "status": 400,
      "error_code": "AI_STP_VALIDATION_ERROR"
    },
    {
      "case_id": "exchangeDeviceCode.approved",
      "operation_id": "exchangeDeviceCode",
      "kind": "positive",
      "why": "The exchange is what binds the device key, so the request carries the identity the approved account will hold.",
      "request": {
        "body": {
          "schema_version": 1,
          "device_code": "FIXTUREdeviceCODE0123456789abcdefGHIJKLM",
          "device_id": "device_01JQZK7B8N4M6P2R9T5V0X3Y7Z",
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
          "display_name": "fixture-device"
        }
      },
      "status": 200,
      "body": {
        "schema_version": 1,
        "access_token": "fixture-access-token",
        "refresh_token": "fixture-refresh-token",
        "token_type": "Bearer",
        "expires_in": 3600,
        "account_id": "account_01JQZK7B8N4M6P2R9T5V0X3Y7Z",
        "device_id": "device_01JQZK7B8N4M6P2R9T5V0X3Y7Z"
      }
    },
    {
      "case_id": "exchangeDeviceCode.notYetApproved",
      "operation_id": "exchangeDeviceCode",
      "kind": "rejected_request",
      "why": "A pending poll is a typed error, never an empty token payload: a client must not be able to mistake not-yet for no-credentials-issued.",
      "request": {
        "body": {
          "schema_version": 1,
          "device_code": "FIXTUREpendingCODE0123456789abcdefGHIJKL",
          "device_id": "device_01JQZK7B8N4M6P2R9T5V0X3Y7Z",
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
          "display_name": "fixture-device"
        }
      },
      "status": 400,
      "error_code": "AI_STP_AUTHORIZATION_PENDING"
    },
    {
      "case_id": "exchangeDeviceCode.expiredCode",
      "operation_id": "exchangeDeviceCode",
      "kind": "rejected_request",
      "why": "Expiry is distinct from pending and from declined; a client backs off differently for each, so they may not collapse into one code.",
      "request": {
        "body": {
          "schema_version": 1,
          "device_code": "FIXTUREexpiredCODE0123456789abcdefGHIJKL",
          "device_id": "device_01JQZK7B8N4M6P2R9T5V0X3Y7Z",
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
          "display_name": "fixture-device"
        }
      },
      "status": 400,
      "error_code": "AI_STP_AUTHORIZATION_EXPIRED"
    },
    {
      "case_id": "exchangeDeviceCode.signatureShapedKey",
      "operation_id": "exchangeDeviceCode",
      "kind": "rejected_request",
      "why": "Sixty-four bytes is a signature, not an Ed25519 public key; accepting it would bind an identity nothing can verify against.",
      "request": {
        "body": {
          "schema_version": 1,
          "device_code": "FIXTUREdeviceCODE0123456789abcdefGHIJKLM",
          "device_id": "device_01JQZK7B8N4M6P2R9T5V0X3Y7Z",
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==",
          "display_name": "fixture-device"
        }
      },
      "status": 400,
      "error_code": "AI_STP_VALIDATION_ERROR"
    },
    {
      "case_id": "readOAuthCallbackResult.linked",
      "operation_id": "readOAuthCallbackResult",
      "kind": "positive",
      "why": "The browser half completed and the identity is linked to an account.",
      "request": {
        "path_params": {
          "provider": "github"
        }
      },
      "status": 200,
      "body": {
        "schema_version": 1,
        "provider": "github",
        "status": "linked",
        "account_id": "account_01JQZK7B8N4M6P2R9T5V0X3Y7Z",
        "completed_at": "2026-08-05T00:00:00.000Z"
      }
    },
    {
      "case_id": "readOAuthCallbackResult.conflict",
      "operation_id": "readOAuthCallbackResult",
      "kind": "positive",
      "why": "Two populated accounts are never merged silently, and the conflicting account is not named: naming it would disclose that it exists.",
      "request": {
        "path_params": {
          "provider": "google"
        }
      },
      "status": 200,
      "body": {
        "schema_version": 1,
        "provider": "google",
        "status": "conflict",
        "account_id": null,
        "completed_at": "2026-08-05T00:00:00.000Z"
      }
    },
    {
      "case_id": "startDeviceAuthorization.ambiguousUserCode",
      "operation_id": "startDeviceAuthorization",
      "kind": "invalid_response",
      "why": "A human retypes this code from a terminal into a browser, so the alphabet excludes I, L, O and U. A server emitting one is emitting a code that will be mistyped.",
      "request": {
        "body": {
          "schema_version": 1,
          "provider": "google",
          "idempotency_key": "0123456789abcdef0123456789abcdef"
        }
      },
      "status": 201,
      "body": {
        "schema_version": 1,
        "device_code": "FIXTUREdeviceCODE0123456789abcdefGHIJKLM",
        "user_code": "IOUL-BCDF",
        "verification_uri": "https://ai-stp.example/device",
        "verification_uri_complete": "https://ai-stp.example/device?code=IOUL-BCDF",
        "expires_in": 600,
        "interval": 5
      }
    },
    {
      "case_id": "startDeviceAuthorization.insecureVerificationUri",
      "operation_id": "startDeviceAuthorization",
      "kind": "invalid_response",
      "why": "The browser is sent to this address to approve an account; over plaintext the approval is interceptable.",
      "request": {
        "body": {
          "schema_version": 1,
          "provider": "google",
          "idempotency_key": "0123456789abcdef0123456789abcdef"
        }
      },
      "status": 201,
      "body": {
        "schema_version": 1,
        "device_code": "FIXTUREdeviceCODE0123456789abcdefGHIJKLM",
        "user_code": "BCDF-GHJK",
        "verification_uri": "http://ai-stp.example/device",
        "verification_uri_complete": "http://ai-stp.example/device?code=BCDF-GHJK",
        "expires_in": 600,
        "interval": 5
      }
    },
    {
      "case_id": "readAuthMe.session",
      "operation_id": "readAuthMe",
      "kind": "positive",
      "why": "The session probe returns only the account and optional device ids: enough to answer who is signed in without replaying profile fields.",
      "request": {},
      "status": 200,
      "body": {
        "schema_version": 1,
        "account_id": "account_01JQZK7B8N4M6P2R9T5V0X3Y7Z",
        "device_id": "device_01JQZK7B8N4M6P2R9T5V0X3Y7Z"
      }
    },
    {
      "case_id": "logoutSession.revoked",
      "operation_id": "logoutSession",
      "kind": "positive",
      "why": "Logout is a resource body confirming the opaque session was revoked, not an empty 204 that a proxy could invent.",
      "request": {},
      "status": 200,
      "body": {
        "schema_version": 1,
        "revoked": true
      }
    }
  ]
}
