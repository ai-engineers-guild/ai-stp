# Pinned scanner tool versions for worker-safety image builds.
# Bump deliberately; record the reason in the PR that changes pins.
# Verified against GitHub/PyPI release assets on 2026-10-04.

GITLEAKS_VERSION=8.30.1
OPENGREP_VERSION=1.30.0
OSV_SCANNER_VERSION=2.6.0
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256_LINUX_X86_64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
SHELLCHECK_SHA256_LINUX_AARCH64=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588
OPENGREP_SHA256_LINUX_X86=35779bdd72e92129c8df2a77f0c55e8c08356801ea92591ef32108d6b28d564c
OPENGREP_SHA256_LINUX_AARCH64=a5d5a4a58ba5d46ff51e921663da1c2bba38f4b03987f4aeec87f16c6ad3ecae
YARA_VERSION=4.5.2
# Python tools installed with uv into /opt/safety-venv (not the app venv)
BANDIT_VERSION=1.9.4
PIP_AUDIT_VERSION=2.10.1
# Go tools: gosec from GitHub release tarball; govulncheck via go install (required)
GOSEC_VERSION=2.29.0
GOVULNCHECK_VERSION=v1.1.4
# Skill engines (required in worker-safety). They are combined with the independent
# owned static rules; model runtimes are deliberately not installed.
SKILLSPECTOR_GIT_URL=https://github.com/NVIDIA/skillspector.git
SKILLSPECTOR_GIT_REF=v2.12.0
SKILL_SCANNER_PACKAGE=cisco-ai-skill-scanner
SKILL_SCANNER_VERSION=2.2.0
# Since 2.2.0 the scanner ships per-platform wheels instead of one
# py3-none-any wheel, so the pin is per architecture like opengrep's.
SKILL_SCANNER_WHEEL_URL_LINUX_X86_64=https://files.pythonhosted.org/packages/b7/81/8a77022d9eb618fb69133f944e79d654312b8356f6cc77a3f74b6f223ac9/cisco_ai_skill_scanner-2.2.0-cp311.cp312.cp313.cp314-none-manylinux_2_17_x86_64.whl
SKILL_SCANNER_WHEEL_SHA256_LINUX_X86_64=1d974d1b207b21628f9f44779797f52df85c6e58240b036f2666421a2ed88098
SKILL_SCANNER_WHEEL_URL_LINUX_AARCH64=https://files.pythonhosted.org/packages/78/f2/0b0655e610eef166deecf4888b9ee469c20a61c481dbbcf2b1650840bfb9/cisco_ai_skill_scanner-2.2.0-cp311.cp312.cp313.cp314-none-manylinux_2_17_aarch64.whl
SKILL_SCANNER_WHEEL_SHA256_LINUX_AARCH64=81cbe3f5afe56e5de415dda72ac98b25a5dcdd3b1ca0130f1ec7a384cd4287e2
# ClamAV, YARA and Bubblewrap come from the exact distro package versions in
# deploy/docker/Dockerfile.app (worker-safety stage).
