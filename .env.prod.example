# Production environment example. Copy to .env.prod and fill real secrets there.
# Real .env.prod is gitignored and must never be committed (SPEC-019 REQ-1901).

POSTGRES_USER=ai_stp
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_stp

AI_STP_DB_URL=postgresql+asyncpg://ai_stp:CHANGE_ME@postgres:5432/ai_stp
AI_STP_DB_POOL_SIZE=10

AI_STP_STORAGE_ENDPOINT=http://rustfs:9000
AI_STP_STORAGE_BUCKET=ai-stp
AI_STP_STORAGE_ACCESS_KEY_ID=CHANGE_ME
AI_STP_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
AI_STP_STORAGE_REGION=us-east-1
AI_STP_STORAGE_KEY_PREFIX=objects
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME

AI_STP_API_ENVIRONMENT=prod
AI_STP_API_LOG_DIR=/var/log/ai_stp
# Optional OpenObserve profile: leave both unset to disable telemetry export.
# The endpoint is the exact OTLP traces path; the header belongs to a dedicated
# ingestion identity, never the initial OpenObserve root account.
# AI_STP_API_OTEL_EXPORTER_ENDPOINT=http://openobserve:5080/api/default/v1/traces
# AI_STP_API_OTEL_EXPORTER_HEADERS=Authorization=Basic REPLACE_AT_RUNTIME
# Single-node MVP policy (ADR-0128): 100 requests per minute overall and
# 1000 requests per hour per transport peer, with a bounded 2048-key
# memory budget for the per-peer table. Explicit 0 disables that dimension.
# Sensitive per-route policies remain a follow-up.
AI_STP_API_RATE_LIMIT_OVERALL_REQUESTS=100
AI_STP_API_RATE_LIMIT_OVERALL_WINDOW_SECONDS=60
AI_STP_API_RATE_LIMIT_IP_REQUESTS=1000
AI_STP_API_RATE_LIMIT_IP_WINDOW_SECONDS=3600
AI_STP_API_RATE_LIMIT_MAX_KEYS=2048
# Optional profile bootstrap. Select the exact digest during the deployment
# approval; these values stay only in gitignored .env.prod/runtime secret store.
# AI_STP_OPENOBSERVE_IMAGE=o2cr.ai/openobserve/openobserve-enterprise@sha256:...
# ZO_ROOT_USER_EMAIL=
# ZO_ROOT_USER_PASSWORD=

AI_STP_WORKER_WORKER_ID=worker-prod
AI_STP_WORKER_BATCH_SIZE=20
AI_STP_WORKER_LOG_DIR=/var/log/ai_stp
# Public GitHub token for Official upstream and catalog stars. Required once
# the catalog has more git sources than GitHub's 60 unauthenticated requests
# per hour. Fine-grained: public metadata read only. Never commit the real value.
AI_STP_WORKER_GITHUB_TOKEN=CHANGE_ME

# Safety worker (Dockerfile.worker-safety): keep RUSTFS_* equal to AI_STP_STORAGE_*.
AI_STP_SAFETY_EXTERNAL_CLI=1
AI_STP_SAFETY_SANDBOX=auto
AI_STP_OSV_OFFLINE_DIR=/var/lib/ai_stp/osv
OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY=/var/lib/ai_stp/osv
AI_STP_OSV_MAX_AGE_HOURS=36
# AI_STP_OSV_REQUIRE_FRESH=1
AI_STP_WORKER_POLL_INTERVAL_SECONDS=1.0
AI_STP_WORKER_LOG_DIR=/var/log/ai_stp

# HMAC secret for opaque public-catalog cursors (ADR-0042). No default; min 32 chars.
AI_STP_CATALOG_CURSOR_SIGNING_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_MIN_32_CHARS

# Web tier (SPEC-024 REQ-2402, ADR-0044). Names only; real values stay in gitignored .env.prod.
# Build-time profile is part of the exact web image identity.
AI_STP_WEB_PROFILE=public_saas
# Optional exact boolean build override. Runtime changes do not alter an existing image.
# AI_STP_FEATURE_CONTENT_HUB=false
# Public origin. Replace with the real https origin on the host.
# Canonical public origin for both web metadata and server-built SEO profiles.
NEXT_PUBLIC_APP_URL=https://app.example.invalid
# Optional backend-only override; normally leave unset so both layers share the value above.
# AI_STP_SEO_PUBLIC_ORIGIN=https://app.example.invalid
# Public build has no analytics, marketing tags, or optional-cookie banner.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Public user documentation origin. Keep it on a dedicated subdomain; /docs remains API docs.
AI_STP_USER_DOCS_URL=https://docs.example.invalid
# Replace before enabling the contact form in production.
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.invalid
# Server-side API base: internal compose network, never the public origin.
AI_STP_API_BASE_URL=http://api:8000
# Production must not use web mocks.
AI_STP_USE_MOCKS=false
# Prod uses real OAuth; no auth mock.
AI_STP_MOCK_AUTH=false
# Cookie signing secret for the opaque web session (ADR-0041). Minimum 32 chars.
AI_STP_SESSION_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_MIN_32_CHARS

# Coarse location for the browser-device list (SPEC-023 REQ-2314). Points at a
# City Lite MMDB inside the read-only `deploy/geoip` mount. The database is not
# committed: it is the operator's file, on the operator's update policy. Leave
# unset to keep locations unresolved -- login works either way, and the platform
# stores only city and country, never the address it resolved them from.
# AI_STP_AUTH_GEOIP_CITY_DB_PATH=/srv/geoip/city.mmdb

# Public host names served by the deployment host's nginx (REQ-2406, ADR-0135).
# These are names, not origins: nginx owns TLS and the certificate, so no scheme
# belongs here. deploy/nginx/render.sh reads them to install the route split and
# refuses a name certbot holds no certificate for. Local prod compose rehearsals
# may keep localhost and simply not render any host configuration.
# A site may answer to several names; give them space-separated, first one
# first — it names the rendered file and, by default, the certificate lineage.
AI_STP_PUBLIC_HOST=localhost
AI_STP_DOCS_HOST=docs.localhost

# Optional certbot lineage overrides. certbot names a directory after the first
# request for a name rather than after the name, so a reissue lands in
# `example.com-0001` while the site is still `example.com`. Name the directory
# here when the two differ; otherwise the host name is used.
# AI_STP_TLS_LINEAGE=
# AI_STP_DOCS_TLS_LINEAGE=

# Optional safe-diagnostics identity (REQ-2411). No secrets; commit SHA only.
# AI_STP_API_GIT_COMMIT=

# Required before a public launch. These values are inserted into the immutable
# legal-policy revisions shown to users; use a real controller name, legal
# correspondence address, and monitored privacy mailbox.

# --- Auth (ADR-0041) ---
# Required: the API refuses to start without it, and the failure is a pydantic
# validation error deep in a traceback rather than a message about this file.
# At least 32 characters; generate with `openssl rand -base64 48`.
AI_STP_AUTH_SECRET_KEY=

# Browser-facing origin for post-login redirects.
AI_STP_AUTH_PUBLIC_BASE_URL=https://localhost

# Every browser origin this deployment answers on whose callback is ALSO
# registered in the provider console, comma-separated. The OAuth handshake
# state lives in a session cookie on the origin that started the flow, so a
# deployment serving two domains needs both here and both in the console; a
# sign-in begun on a domain whose callback is not registered lands on the other
# one and fails with no state (`#62`). Empty is the single-domain case and
# behaves exactly as before.
AI_STP_AUTH_OAUTH_CALLBACK_ORIGINS=
AI_STP_AUTH_COOKIE_SECURE=true
AI_STP_AUTH_COOKIE_SAMESITE=lax

# Provider credentials are optional: an empty client id disables that provider
# at startup. Leave them empty until a public domain exists and its callback is
# registered — a provider configured for a different origin fails at the
# redirect, which is harder to read than a provider that is simply off.
AI_STP_AUTH_GOOGLE_CLIENT_ID=
AI_STP_AUTH_GOOGLE_CLIENT_SECRET=
# Optional same-origin path already registered on the Google web client.
# Default: /v1/auth/google/callback.
AI_STP_AUTH_GOOGLE_CALLBACK_PATH=/v1/auth/google/callback
AI_STP_AUTH_GITHUB_CLIENT_ID=
AI_STP_AUTH_GITHUB_CLIENT_SECRET=

# Comma-separated account ids allowed to act as staff: audited admin reads,
# report cases, version lifecycle and `author_verified` (SPEC-007 REQ-715).
# Empty is not "the default staff" — it is nobody, and the whole staff surface
# answers 403 to every account including the operator's. That also closes the
# `authoritative` trust lane for good: the lane needs `author_verified`, only
# this surface grants it, so an unset value leaves every published object in
# `experimental` no matter who published it.
AI_STP_AUTH_ADMIN_ACCOUNT_IDS=

# Scoped bearer for repository article snapshot import (SPEC-054). Empty forbids
# import; the API still starts. The one-shot content-import service needs the
# same value as the API. Never a user session and never a staff grant.
AI_STP_CONTENT_IMPORT_TOKEN=

# Optional SEO enrichment (SPEC-053). Empty / false leaves base revisions
# active. CLIPROXY_* is interpolated only into the LiteLLM container of the
# seo_enrichment profile; the worker never receives those values. CLIPROXY
# listens on the compose network; copy deploy/cliproxy/auths to the server
# and keep AI_STP_CLIPROXY_URL on that DNS name. Do not publish 8317.
AI_STP_SEO_ENRICHMENT_ENABLED=false
AI_STP_SEO_ENRICHMENT_URL=
AI_STP_SEO_ENRICHMENT_CREDENTIAL=
AI_STP_CLIPROXY_URL=http://cliproxy:8317/v1
AI_STP_CLIPROXY_API_KEY=
AI_STP_CLIPROXY_MODEL=openai/seo-writer

# --- Co-tenancy ---
# Where the stack publishes each service for the host's nginx to reach. They stay
# on loopback: the host proxy is the only public entry point, and binding these
# to a public address would expose the services beside the proxy meant to front
# them. Change the ports when the host already serves something there.
AI_STP_WEB_BIND=127.0.0.1:58081
AI_STP_API_BIND=127.0.0.1:58082
AI_STP_DOCS_BIND=127.0.0.1:58083
