# Persistent project knowledge is tracked: project.yml and memories/.
# This file lists only checkout-specific state that tools rewrite during a
# session. It contains a SHA, branch, and absolute machine paths, so in shared
# history it describes another checkout rather than the project.
/cache
/project.local.yml
/.auto_sync_head
/.flow_blocker_ack.json
/.flow_post_task_state.json
/.flow_sync_marker
/.serena_sync_state.json

# Serena ships this maintenance note itself; it documents its own memory
# conventions, is identical in every project, and returns on upgrade.
memories/memory_maintenance.md
