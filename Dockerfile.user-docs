# Multi-stage image for the public user documentation site.

FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217 AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}"
# Pinned by digest and named by version. The tag alone used to be `:0.9`,
# which moves: two builds of the same commit could resolve different `uv`
# releases, so the image was not reproducible from the commit — which
# `SPEC-024` requires and `dependency-policy.md` states as exact versions
# rather than moving references. The version also now matches the one every
# gate installs, so what production resolves the lockfile with is what CI
# proved it with; a contract test holds the two together.
COPY --from=ghcr.io/astral-sh/uv:0.12.1@sha256:cf4eedcaa81655197f625739489effcbe71b61ceb1506f332c3facae5deceded /uv /bin/uv
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends git

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY apps ./apps
RUN uv sync --locked --only-group docs --no-install-project --no-install-workspace

COPY docs_scripts/user-mkdocs.yml ./docs_scripts/user-mkdocs.yml
COPY docs_scripts/user-mkdocs.en.yml ./docs_scripts/user-mkdocs.en.yml
COPY user-docs ./user-docs
COPY user-docs-en ./user-docs-en

FROM base AS dev
ENV AI_STP_USER_DOCS_SITE_URL=http://localhost:8011/
EXPOSE 8000
CMD ["python", "-m", "mkdocs", "serve", "-f", "docs_scripts/user-mkdocs.yml", "-a", "0.0.0.0:8000"]

FROM base AS build
ARG AI_STP_USER_DOCS_SITE_URL=https://docs.example.invalid/
ENV AI_STP_USER_DOCS_SITE_URL=${AI_STP_USER_DOCS_SITE_URL}
ENV AI_STP_USER_DOCS_EN_SITE_URL=${AI_STP_USER_DOCS_SITE_URL}en/
# Russian first: it cleans the site directory, and the English build writes
# `en/` inside it. Reversing these two silently ships one language.
RUN python -m mkdocs build --strict -f docs_scripts/user-mkdocs.yml \
    && python -m mkdocs build --strict -f docs_scripts/user-mkdocs.en.yml

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS prod
COPY deploy/nginx/user-docs.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/.site-user-docs /srv
EXPOSE 8080
