# Development environment example. Copy to .env.dev and adjust.
# Real .env.dev is gitignored and must not be committed (SPEC-019 REQ-1901).

POSTGRES_USER=ai_stp
POSTGRES_PASSWORD=ai_stp_dev
POSTGRES_DB=ai_stp

AI_STP_DB_URL=postgresql+asyncpg://ai_stp:ai_stp_dev@postgres:5432/ai_stp
AI_STP_DB_POOL_SIZE=5

AI_STP_STORAGE_ENDPOINT=http://rustfs:9000
AI_STP_STORAGE_BUCKET=ai-stp-dev
AI_STP_STORAGE_ACCESS_KEY_ID=ai_stp
AI_STP_STORAGE_SECRET_ACCESS_KEY=ai_stp_dev
AI_STP_STORAGE_REGION=us-east-1
AI_STP_STORAGE_KEY_PREFIX=objects
RUSTFS_ACCESS_KEY=ai_stp
RUSTFS_SECRET_KEY=ai_stp_dev

AI_STP_API_ENVIRONMENT=dev
AI_STP_API_VERSION=0.1.0
AI_STP_API_LOG_DIR=/var/log/ai_stp
# AI_STP_API_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces
# Single-node MVP policy (ADR-0128): 100 requests per minute overall and
# 1000 requests per hour per transport peer, with a bounded 2048-key
# memory budget for the per-peer table. Explicit 0 disables that dimension.
AI_STP_API_RATE_LIMIT_OVERALL_REQUESTS=100
AI_STP_API_RATE_LIMIT_OVERALL_WINDOW_SECONDS=60
AI_STP_API_RATE_LIMIT_IP_REQUESTS=1000
AI_STP_API_RATE_LIMIT_IP_WINDOW_SECONDS=3600
AI_STP_API_RATE_LIMIT_MAX_KEYS=2048

AI_STP_WORKER_WORKER_ID=worker-dev
AI_STP_WORKER_BATCH_SIZE=10
AI_STP_WORKER_POLL_INTERVAL_SECONDS=1.0
AI_STP_WORKER_LOG_DIR=/var/log/ai_stp

# Safety worker (Dockerfile.worker-safety): external scanners + OSV offline mount.
AI_STP_SAFETY_EXTERNAL_CLI=1
AI_STP_SAFETY_SANDBOX=auto
AI_STP_OSV_OFFLINE_DIR=/var/lib/ai_stp/osv
OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY=/var/lib/ai_stp/osv
AI_STP_OSV_MAX_AGE_HOURS=36
# Optional: fail worker readiness when OSV offline DB is missing/stale.
# AI_STP_OSV_REQUIRE_FRESH=0

# HMAC secret for opaque public-catalog cursors (ADR-0042). No default; min 32 chars.
# AI_STP_CATALOG_CURSOR_SIGNING_SECRET=

# Web tier (SPEC-024 REQ-2402, ADR-0044). Names only; real values stay in gitignored .env.dev.
# Build-time deploy profile. Restart Next completely after changing it; HMR is insufficient.
AI_STP_WEB_PROFILE=self_hosted
# Optional exact boolean build override. Leave unset to use the selected profile.
# AI_STP_FEATURE_CONTENT_HUB=false
# Public origin is the published web port (no Caddy in local dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Official GA / Yandex Metrika. Empty id = that vendor off. Set
# NEXT_PUBLIC_ANALYTICS_ENABLED=false to disable both even when ids are set.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_YANDEX_METRIKA_COUNTER_ID=
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true
# User documentation is served by the separate docs compose service.
AI_STP_USER_DOCS_URL=http://localhost:8011
AI_STP_USER_DOCS_PORT=8011
# Contact form recipient. Keep unset to show a disabled, explicit placeholder.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Server-side API base: internal compose network, never the public origin.
AI_STP_API_BASE_URL=http://api:8000
# Dev may use in-process mocks; an integrated smoke run sets this false.
AI_STP_USE_MOCKS=false
# Real OAuth/account/devices against the API (provider credentials below).
AI_STP_MOCK_AUTH=false
# Cookie signing secret for the opaque web session (ADR-0041). Minimum 32 chars.
AI_STP_SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# API auth (ADR-0041).
# public_base_url = browser site after login (web origin). OAuth redirect_uri is
# {oauth_redirect_base_url or public_base_url}/v1/auth/{provider}/callback and
# MUST match the provider console exactly.
# AI_STP_AUTH_SECRET_KEY=
# AI_STP_AUTH_PUBLIC_BASE_URL=http://localhost:3000
# If Google/GitHub still list :8000 callbacks (legacy local API port):
# AI_STP_AUTH_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# AI_STP_AUTH_COOKIE_SECURE=false
# AI_STP_AUTH_COOKIE_SAMESITE=lax
# AI_STP_AUTH_GOOGLE_CLIENT_ID=
# AI_STP_AUTH_GOOGLE_CLIENT_SECRET=
# AI_STP_AUTH_GITHUB_CLIENT_ID=
# AI_STP_AUTH_GITHUB_CLIENT_SECRET=
